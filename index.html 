// ======================================

// ======================================
// ЧАСТИНА 5 — ЕКОНОМІКА ТА РОЗВИТОК
// ======================================

(() => {
  let developmentTimer = null;
  let autoDevelopment = true;
  let ticks = 0;

  const panel = document.createElement("section");
  panel.id = "economyPanel";

  panel.style.cssText = `
    background:#1b2b3b;
    border:1px solid #38516a;
    border-radius:12px;
    padding:14px;
    margin:12px;
    color:#f1f5f9;
  `;

  panel.innerHTML = `
    <h3 style="margin:0 0 12px">🏛 Розвиток держави</h3>

    <div id="economyStatus" style="margin-bottom:12px">
      Очікування створення держави...
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button id="nextYearBtn">⏩ Наступний рік</button>
      <button id="autoDevelopmentBtn">⏸ Зупинити розвиток</button>
      <button id="buildFarmBtn">🌾 Побудувати ферму</button>
      <button id="buildHouseBtn">🏠 Побудувати будинок</button>
    </div>

    <div id="buildingList" style="margin-top:12px">
      🏗 Будівлі: ще немає
    </div>

    <div id="economyLog" style="
      margin-top:12px;
      padding:9px;
      background:#101923;
      border-radius:8px;
      min-height:45px;
    ">Історія подій з'явиться тут.</div>
  `;

  const style = document.createElement("style");
  style.textContent = `
    #economyPanel button {
      background:#2563a6;
      color:white;
      border:0;
      border-radius:7px;
      padding:9px 11px;
      cursor:pointer;
      font-weight:bold;
    }
    #economyPanel button:active {
      transform:scale(.97);
    }
  `;
  document.head.appendChild(style);

  const sidebar =
    document.querySelector("aside") ||
    document.querySelector(".sidebar") ||
    document.querySelector("main");

  if (sidebar) {
    sidebar.appendChild(panel);
  } else {
    document.body.appendChild(panel);
  }

  const status = document.getElementById("economyStatus");
  const log = document.getElementById("economyLog");
  const buildingList = document.getElementById("buildingList");

  const buildings = {
    farm: 0,
    house: 0
  };

  function getCountry() {
    return window.playerCountry || null;
  }

  function updateStats() {
    const country = getCountry();
    if (!country) return;

    const values = {
      countryDisplay: country.name,
      yearDisplay: country.year,
      populationDisplay: country.population.toLocaleString("uk-UA"),
      treasuryDisplay: country.treasury.toLocaleString("uk-UA"),
      foodDisplay: country.food.toLocaleString("uk-UA"),
      woodDisplay: country.wood.toLocaleString("uk-UA"),
      stoneDisplay: country.stone.toLocaleString("uk-UA"),
      ironDisplay: country.iron.toLocaleString("uk-UA")
    };

    Object.entries(values).forEach(([id, value]) => {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    });

    status.textContent =
      "📅 " + country.year +
      " рік | 👥 " + country.population.toLocaleString("uk-UA") +
      " жителів | 💰 " + country.treasury.toLocaleString("uk-UA");
  }

  function addLog(message) {
    const time = new Date().toLocaleTimeString("uk-UA", {
      hour: "2-digit",
      minute: "2-digit"
    });

    log.textContent = time + " — " + message;
  }

  function updateBuildings() {
    buildingList.textContent =
      "🌾 Ферми: " + buildings.farm +
      " | 🏠 Будинки: " + buildings.house;
  }

  function advanceYear() {
    const country = getCountry();

    if (!country) {
      addLog("Спочатку створи державу.");
      return;
    }

    country.year += 1;
    ticks += 1;

    const farmProduction = buildings.farm * 180;
    const houseGrowth = buildings.house * 35;

    const taxIncome = Math.floor(country.population * 0.08);

    country.food += 350 + farmProduction;
    country.wood += 45 + buildings.farm * 5;
    country.stone += 25;
    country.iron += 10;
    country.treasury += 200 + taxIncome;

    country.food -= Math.floor(country.population * 0.025);

    country.population +=
      30 +
      houseGrowth +
      Math.floor(buildings.farm * 8);

    if (country.food < 0) {
      country.food = 0;
      country.population = Math.max(
        100,
        country.population - 50
      );
      addLog("⚠️ Нестача їжі сповільнила розвиток.");
    } else {
      addLog("📈 Настав " + country.year + " рік. Держава розвивається.");
    }

    updateStats();
  }

  function build(type) {
    const country = getCountry();

    if (!country) {
      addLog("Спочатку створи державу.");
      return;
    }

    if (type === "farm") {
      if (country.wood < 120 || country.treasury < 250) {
        addLog("Не вистачає дерева або золота для ферми.");
        return;
      }

      country.wood -= 120;
      country.treasury -= 250;
      buildings.farm += 1;

      addLog("🌾 Побудовано нову ферму.");
    }

    if (type === "house") {
      if (country.wood < 80 || country.stone < 40 ||
          country.treasury < 150) {
        addLog("Не вистачає ресурсів для будинку.");
        return;
      }

      country.wood -= 80;
      country.stone -= 40;
      country.treasury -= 150;
      buildings.house += 1;

      addLog("🏠 Побудовано новий будинок.");
    }

    updateBuildings();
    updateStats();
  }

  function startDevelopment() {
    if (developmentTimer) return;

    developmentTimer = setInterval(() => {
      if (!window.gameStarted || !getCountry()) return;

      if (autoDevelopment) {
        advanceYear();
      }
    }, 12000);
  }

  document.getElementById("nextYearBtn").addEventListener(
    "click",
    advanceYear
  );

  document.getElementById("autoDevelopmentBtn").addEventListener(
    "click",
    () => {
      autoDevelopment = !autoDevelopment;

      document.getElementById("autoDevelopmentBtn").textContent =
        autoDevelopment
          ? "⏸ Зупинити розвиток"
          : "▶️ Увімкнути розвиток";

      addLog(
        autoDevelopment
          ? "Автоматичний розвиток увімкнено."
          : "Автоматичний розвиток зупинено."
      );
    }
  );

  document.getElementById("buildFarmBtn").addEventListener(
    "click",
    () => build("farm")
  );

  document.getElementById("buildHouseBtn").addEventListener(
    "click",
    () => build("house")
  );

  window.addEventListener("countryFounded", () => {
    updateStats();
    updateBuildings();
    startDevelopment();
    addLog("Держава почала розвиватися!");
  });

  if (window.gameStarted && getCountry()) {
    updateStats();
    updateBuildings();
    startDevelopment();
  }

  console.log("Частина 5 завантажена успішно");
})();

