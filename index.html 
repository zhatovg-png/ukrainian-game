function populationGrowth() {
    gameData.cities.forEach(city => {
        let growth = Math.max(
            1,
            Math.floor(city.population * 0.0002)
        );

        if (city.happiness < 30) {
            growth = 0;
        }

        city.population += growth;

        city.happiness = Math.min(
            100,
            Math.max(0, city.happiness)
        );
    });

    gameData.villages.forEach(village => {
        village.population += Math.max(
            1,
            Math.floor(village.population * 0.0001)
        );

        if (village.population >= 5000) {
            convertVillageToCity(village);
        }
    });
}

function convertVillageToCity(village) {
    const index = gameData.villages.indexOf(village);

    if (index === -1) return;

    const city = {
        id: Date.now() + Math.random(),
        name: village.name,
        lat: village.lat,
        lng: village.lng,
        population: village.population,
        happiness: village.happiness,
        level: 1,
        type: "місто",
        buildings: [],
        factories: 0,
        bridges: 0,
        farms: 0,
        roads: 0,
        damaged: false
    };

    gameData.cities.push(city);
    gameData.villages.splice(index, 1);

    const marker = L.marker([city.lat, city.lng])
        .addTo(map)
        .bindPopup(
            `<b>${escapeHTML(city.name)}</b><br>Нове місто`
        );

    mapMarkers.push(marker);

    addHistory(
        "Село " + city.name +
        " отримало статус міста!"
    );
}

