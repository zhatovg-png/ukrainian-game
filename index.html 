
<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Моя Україна — розвиток країни</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #101820;
  color: #edf4f7;
  font-family: Arial, sans-serif;
}

header {
  padding: 14px;
  background: #09131b;
  border-bottom: 1px solid #385264;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

h1 {
  font-size: 20px;
  margin: 0;
}

h2 {
  font-size: 17px;
  margin-top: 0;
}

small {
  color: #aec0ca;
}

button {
  background: #2d4a5c;
  color: white;
  border: 1px solid #4a6b80;
  border-radius: 8px;
  padding: 9px;
  cursor: pointer;
  margin: 3px;
}

button:hover {
  background: #3c6077;
}

button:disabled {
  opacity: 0.4;
}

input {
  width: 100%;
  padding: 9px;
  margin: 5px 0 10px;
  background: #0f1b23;
  color: white;
  border: 1px solid #385264;
  border-radius: 7px;
}

.layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 350px;
  gap: 12px;
  padding: 12px;
}

#map {
  height: calc(100vh - 110px);
  min-height: 450px;
  border-radius: 10px;
}

.side {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-height: calc(100vh - 110px);
  overflow-y: auto;
}

.panel {
  background: #192936;
  border: 1px solid #385264;
  border-radius: 10px;
  padding: 12px;
}

.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
}

.stat {
  background: #243b4a;
  padding: 8px;
  border-radius: 7px;
}

.stat b {
  display: block;
  color: #f1c75b;
  font-size: 17px;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
}

.tabs button {
  font-size: 12px;
}

.tab {
  display: none;
}

.tab.active {
  display: block;
}

.buildgrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
}

.buildgrid button {
  text-align: left;
  font-size: 12px;
  min-height: 48px;
}

.notice {
  background: #294353;
  padding: 9px;
  border-radius: 7px;
  font-size: 13px;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin: 7px 0;
}

.log {
  max-height: 200px;
  overflow-y: auto;
  font-size: 13px;
}

.log div {
  padding: 5px;
  border-bottom: 1px solid #385264;
}

@media(max-width: 850px) {
  .layout {
    grid-template-columns: 1fr;
  }

  #map {
    height: 55vh;
    min-height: 350px;
  }

  .side {
    max-height: none;
  }
}
</style>
</head>

<body>

<header>
  <div>
    <h1>🇺🇦 Моя Україна</h1>
    <small>Симулятор розвитку власної держави</small>
  </div>

  <div>
    <b id="date">Січень 2016</b>
    <button id="pause">⏸ Пауза</button>
    <button id="speed">⏩ ×1</button>
  </div>
</header>

<div class="layout">

<main>
  <div id="map"></div>
</main>

<aside class="side">

<section class="panel">
  <h2>🏛 Твоя держава</h2>

  <div id="setup">
    <label>Назва країни</label>
    <input id="country" value="Нова Україна">

    <label>Назва першого міста</label>
    <input id="city" value="Моє місто">

    <p class="notice">
      Натисни на карту України, щоб обрати місце
      для заснування своєї першої столиці.
    </p>

    <p id="chosen">Місце ще не обране.</p>

    <button id="found" disabled>
      🏙 Заснувати державу
    </button>
  </div>

  <div id="stats" style="display:none">
    <div class="stats">

      <div class="stat">
        Казна
        <b id="money">0</b>
        <small>грн</small>
      </div>

      <div class="stat">
        Населення
        <b id="pop">0</b>
      </div>

      <div class="stat">
        Щастя
        <b id="happy">0%</b>
      </div>

      <div class="stat">
        Їжа
        <b id="food">0</b>
      </div>

      <div class="stat">
        Міста / села
        <b id="settlements">0</b>
      </div>

      <div class="stat">
        Баланс
        <b id="balance">0</b>
      </div>

    </div>

    <div class="row">
      <span>Столиця:</span>
      <b id="capital">—</b>
    </div>
  </div>
</section>

<section class="panel">

  <div class="tabs">
    <button data-tab="build" class="active">Будівництво</button>
    <button data-tab="economy">Економіка</button>
    <button data-tab="people">Населення</button>
    <button data-tab="bots">Держави-боти</button>
    <button data-tab="state">Управління</button>
    <button data-tab="journal">Хроніка</button>
  </div>

  <div id="build" class="tab active">
    <p class="notice">
      Обери будівлю, а потім натисни на карту.
    </p>
    <div class="buildgrid" id="buildings"></div>
    <p id="buildHint">Спочатку заснуй місто.</p>
  </div>

  <div id="economy" class="tab">
    <h3>Ресурси</h3>
    <div id="resources" class="stats"></div>
    <h3>Економіка та логістика</h3>
    <div id="econInfo"></div>
    <button id="sell">Продати ресурси</button>
  </div>

  <div id="people" class="tab">
    <div id="peopleInfo"></div>
    <h3>Робота</h3>
    <button id="work">Працювати</button>
    <button id="shop">Відкрити крамницю</button>
    <h3>Села</h3>
    <div id="villages"></div>
  </div>

  <div id="bots" class="tab">
    <h3>Інші держави</h3>
    <div id="botList"></div>
  </div>

  <div id="state" class="tab">
    <h3>Податки</h3>
    <div id="taxVal">10%</div>
    <input id="tax" type="range" min="2" max="25" value="10">

    <h3>Вибори президента</h3>
    <div id="election">Ще не проводилися.</div>
    <button id="vote">🗳 Провести вибори</button>

    <h3>Воєнний сценарій</h3>
    <div id="warText">Не активний.</div>
    <button id="war">Увімкнути сценарій</button>
    <button id="peace">Завершити сценарій</button>
  </div>

  <div id="journal" class="tab">
    <h3>Хроніка країни</h3>
    <div id="log" class="log"></div>
  </div>

</section>

</aside>
</div>
</body>
</html>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
"use strict";

const $ = id => document.getElementById(id);

const game = {
  year: 2016,
  month: 1,
  day: 1,
  paused: false,
  speed: 1,
  started: false,
  country: "",
  capital: "",
  money: 1000000,
  population: 1200,
  happiness: 70,
  food: 5000,
  taxRate: 10,
  chosen: null,
  cities: [],
  villages: [],
  buildings: [],
  bots: [],
  resources: {
    wood: 1000,
    stone: 1000,
    iron: 500,
    coal: 300,
    gas: 200,
    oil: 100,
    electricity: 0
  },
  war: false,
  warDays: 0,
  pontoonDays: 0,
  votes: 0,
  log: []
};

const buildingTypes = [
  {id:"house",name:"Житловий будинок",cost:15000,jobs:0,people:80,income:0,resource:null,coast:false},
  {id:"farm",name:"Ферма",cost:12000,jobs:15,people:0,income:1200,resource:null,coast:false},
  {id:"school",name:"Школа",cost:30000,jobs:25,people:0,income:-300,resource:null,coast:false},
  {id:"hospital",name:"Лікарня",cost:50000,jobs:40,people:0,income:-700,resource:null,coast:false},
  {id:"market",name:"Магазин",cost:18000,jobs:12,people:0,income:900,resource:null,coast:false},
  {id:"factory",name:"Завод",cost:90000,jobs:100,people:0,income:5000,resource:"iron",coast:false},
  {id:"sawmill",name:"Лісопилка",cost:25000,jobs:20,people:0,income:1800,resource:"wood",coast:false},
  {id:"quarry",name:"Кар'єр",cost:35000,jobs:30,people:0,income:2200,resource:"stone",coast:false},
  {id:"mine",name:"Шахта",cost:65000,jobs:60,people:0,income:3500,resource:"coal",coast:false},
  {id:"power",name:"Електростанція",cost:120000,jobs:50,people:0,income:2500,resource:"coal",coast:false},
  {id:"port",name:"Морський порт",cost:150000,jobs:80,people:0,income:7000,resource:null,coast:true},
  {id:"road",name:"Дорога",cost:5000,jobs:0,people:0,income:300,resource:null,coast:false},
  {id:"rail",name:"Залізниця",cost:80000,jobs:20,people:0,income:1800,resource:"iron",coast:false},
  {id:"bridge",name:"Міст",cost:45000,jobs:10,people:0,income:500,resource:"stone",coast:false}
];

const deposits = [
  {name:"Залізна руда",type:"iron",lat:48.02,lon:37.80},
  {name:"Вугілля",type:"coal",lat:48.30,lon:38.00},
  {name:"Марганець",type:"iron",lat:47.65,lon:34.65},
  {name:"Титан",type:"iron",lat:46.95,lon:32.00},
  {name:"Газ",type:"gas",lat:49.80,lon:35.50},
  {name:"Камінь",type:"stone",lat:48.45,lon:26.80},
  {name:"Лісові ресурси",type:"wood",lat:51.20,lon:25.50}
];

const map = L.map("map").setView([48.7,31.2],6);

L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{
  attribution:"© OpenStreetMap"
}).addTo(map);

const markers = L.layerGroup().addTo(map);
const depositLayer = L.layerGroup().addTo(map);
const settlementLayer = L.layerGroup().addTo(map);

L.polyline([
  [51.5,24.7],[50.9,25.3],[50.1,25.5],[49.5,25.6],
  [48.9,25.9],[48.5,26.0],[47.8,29.0],[47.0,30.7],
  [46.5,30.7]
],{color:"#36a6e8",weight:4,opacity:.8}).addTo(map);

L.polyline([
  [51.8,31.4],[51.0,31.3],[50.4,30.5],[49.5,31.3],
  [48.5,35.0],[47.5,35.1],[46.5,32.7]
],{color:"#36a6e8",weight:4,opacity:.8}).addTo(map);

L.polyline([
  [50.8,33.0],[50.0,33.0],[49.0,32.5],[48.0,32.0],
  [47.0,32.0]
],{color:"#36a6e8",weight:3,opacity:.7}).addTo(map);

deposits.forEach(d=>{
  L.circleMarker([d.lat,d.lon],{
    radius:7,
    color:"#f0b429",
    fillColor:"#f0b429",
    fillOpacity:.8
  }).bindPopup("Ресурсна зона: "+d.name).addTo(depositLayer);
});

map.on("click",event=>{
  if(game.started) return;

  game.chosen = event.latlng;

  $("chosen").textContent =
    "Обрана точка: "+
    event.latlng.lat.toFixed(3)+", "+
    event.latlng.lng.toFixed(3);

  markers.clearLayers();

  L.marker(event.latlng)
    .addTo(markers)
    .bindPopup("Місце майбутньої столиці")
    .openPopup();
});

function addLog(message){
  const stamp =
    `${game.day}.${game.month}.${game.year}`;

  game.log.unshift(`[${stamp}] ${message}`);

  if(game.log.length>60){
    game.log.pop();
  }

  $("log").innerHTML = game.log.map(item=>
    `<div class="log-entry">${escapeHTML(item)}</div>`
  ).join("");
}

function escapeHTML(value){
  return String(value).replace(/[&<>"']/g,char=>({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  }[char]));
}

function distance(a,b){
  const rad=x=>x*Math.PI/180;
  const dLat=rad(b.lat-a.lat);
  const dLon=rad(b.lng-a.lng);

  const x=
    Math.sin(dLat/2)**2+
    Math.cos(rad(a.lat))*
    Math.cos(rad(b.lat))*
    Math.sin(dLon/2)**2;

  return 6371*2*Math.atan2(
    Math.sqrt(x),
    Math.sqrt(1-x)
  );
}

function nearDeposit(type,point,range=90){
  return deposits.some(d=>
    d.type===type &&
    distance(point,{lat:d.lat,lng:d.lon})<=range
  );
}

function nearSea(point){
  return point.lat<47.2 &&
    point.lng>29.0 &&
    point.lng<38.5;
}

function addBotCountries(){
  const names=[
    ["Польща",52.1,21.0],
    ["Білорусь",53.9,27.5],
    ["Словаччина",48.7,19.7],
    ["Угорщина",47.5,19.0],
    ["Румунія",44.4,26.1],
    ["Молдова",47.0,28.8]
  ];

  game.bots=names.map((item,index)=>({
    id:index,
    name:item[0],
    lat:item[1],
    lon:item[2],
    population:500000+index*180000,
    money:8000000+index*1500000,
    cities:2+index,
    happiness:60+index*3,
    development:20+index*4
  }));

  renderBots();
}

function renderBots(){
  $("botList").innerHTML=game.bots.map(bot=>`
    <div class="bot-card">
      <b>${escapeHTML(bot.name)}</b>
      <div>Населення: ${Math.round(bot.population).toLocaleString("uk-UA")}</div>
      <div>Міста: ${bot.cities}</div>
      <div>Економіка: ${bot.development.toFixed(1)}%</div>
      <div>Добробут: ${bot.happiness.toFixed(0)}%</div>
    </div>
  `).join("");
}

function startGame(){
  const countryName = $("country").value.trim();
  const cityName = $("city").value.trim();

  if(!countryName){
    alert("Введи назву своєї країни!");
    return;
  }

  if(!cityName){
    alert("Введи назву столиці!");
    return;
  }

  if(!game.chosen){
    alert("Спочатку обери місце на карті!");
    return;
  }

  game.country = countryName;
  game.capital = cityName;
  game.started = true;

  game.cities.push({
    id:1,
    name:cityName,
    lat:game.chosen.lat,
    lon:game.chosen.lng,
    population:game.population,
    level:"Місто"
  });

  $("setup").style.display = "none";
  $("stats").style.display = "grid";

  addBotCountries();
  drawSettlements();
  renderBuildings();
  updateUI();

  addLog("Засновано державу "+game.country+".");
  addLog("Столиця: "+game.capital+".");
}

$("found").addEventListener("click",startGame);

function drawSettlements(){
  settlementLayer.clearLayers();

  game.cities.forEach(city=>{
    L.circleMarker([city.lat,city.lon],{
      radius:10,
      color:"#f5c542",
      fillColor:"#f5c542",
      fillOpacity:.9
    })
    .bindPopup(
      "<b>"+escapeHTML(city.name)+"</b><br>"+
      "Населення: "+Math.round(city.population)
    )
    .addTo(settlementLayer);
  });

  game.villages.forEach(village=>{
    L.circleMarker([village.lat,village.lon],{
      radius:6,
      color:"#65bd75",
      fillColor:"#65bd75",
      fillOpacity:.9
    })
    .bindPopup(
      "<b>"+escapeHTML(village.name)+"</b><br>"+
      "Населення: "+Math.round(village.population)
    )
    .addTo(settlementLayer);
  });
}

function renderBuildings(){
  $("buildings").innerHTML = buildingTypes.map(type=>`
    <button class="building-button" data-building="${type.id}">
      <b>${type.name}</b>
      <span>Вартість: ${type.cost.toLocaleString("uk-UA")} ₴</span>
      <span>Робочі місця: ${type.jobs}</span>
    </button>
  `).join("");

  document.querySelectorAll("[data-building]").forEach(button=>{
    button.addEventListener("click",()=>{
      build(button.dataset.building);
    });
  });
}

function build(id){
  if(!game.started) return;

  const type = buildingTypes.find(item=>item.id===id);

  if(!type) return;

  if(game.money<type.cost){
    alert("Недостатньо коштів!");
    return;
  }

  const point = game.chosen;

  if(type.coast && !nearSea(point)){
    alert("Порт можна будувати лише біля моря!");
    return;
  }

  if(type.resource && !nearDeposit(type.resource,point)){
    alert("Потрібна відповідна ресурсна зона поблизу!");
    return;
  }

  if(type.resource && game.resources[type.resource]<20){
    alert("Недостатньо ресурсів для будівництва!");
    return;
  }

  game.money-=type.cost;

  if(type.resource){
    game.resources[type.resource]-=20;
  }

  game.buildings.push({
    id:type.id,
    name:type.name,
    jobs:type.jobs,
    people:type.people,
    income:type.income
  });

  if(type.people){
    game.population+=type.people;
  }

  addLog("Побудовано: "+type.name+".");
  updateUI();
  renderBuildings();
}

function updateUI(){
  $("date").textContent =
    `${game.day}.${String(game.month).padStart(2,"0")}.${game.year}`;

  $("money").textContent =
    Math.round(game.money).toLocaleString("uk-UA")+" ₴";

  $("pop").textContent =
    Math.round(game.population).toLocaleString("uk-UA");

  $("happy").textContent =
    Math.round(game.happiness)+"%";

  $("food").textContent =
    Math.round(game.food).toLocaleString("uk-UA");

  $("settlements").textContent =
    game.cities.length+game.villages.length;

  const income = game.buildings.reduce(
    (sum,item)=>sum+item.income,0
  );

  $("balance").textContent =
    Math.round(income).toLocaleString("uk-UA")+" ₴";

  $("capital").textContent = game.capital;

  $("resources").innerHTML = `
    <div>Деревина: ${game.resources.wood}</div>
    <div>Камінь: ${game.resources.stone}</div>
    <div>Залізо: ${game.resources.iron}</div>
    <div>Вугілля: ${game.resources.coal}</div>
    <div>Газ: ${game.resources.gas}</div>
    <div>Нафта: ${game.resources.oil}</div>
    <div>Електроенергія: ${game.resources.electricity}</div>
  `;

  $("econInfo").textContent =
    "Податкова ставка: "+game.taxRate+"%. "+
    "Будівель: "+game.buildings.length;

  $("peopleInfo").textContent =
    "Населення держави: "+
    Math.round(game.population).toLocaleString("uk-UA")+
    ". Робочі місця: "+
    game.buildings.reduce((sum,item)=>sum+item.jobs,0);

  $("buildHint").textContent =
    "Обирай будівлю. Ресурсні споруди потребують відповідних родовищ.";

  $("villages").textContent =
    "Сіл: "+game.villages.length+
    " | Міст: "+game.cities.length;
}

function changeTab(tab){
  document.querySelectorAll(".tab-content").forEach(element=>{
    element.style.display="none";
  });

  document.querySelectorAll("[data-tab]").forEach(element=>{
    element.classList.remove("active");
  });

  const content=$(tab);

  if(content) content.style.display="block";

  const button=document.querySelector(`[data-tab="${tab}"]`);

  if(button) button.classList.add("active");
}

document.querySelectorAll("[data-tab]").forEach(button=>{
  button.addEventListener("click",()=>{
    changeTab(button.dataset.tab);
  });
});

function collectTaxes(){
  if(!game.started) return;

  const income = game.population*(game.taxRate/100)*12;

  game.money+=income;

  game.happiness-=game.taxRate>15?5:2;

  game.happiness=Math.max(0,Math.min(100,game.happiness));

  addLog("Зібрано податки: "+Math.round(income).toLocaleString("uk-UA")+" ₴.");
  updateUI();
}

$("tax").addEventListener("click",collectTaxes);

$("taxVal").addEventListener("input",event=>{
  game.taxRate=Number(event.target.value);
  $("taxVal").nextElementSibling.textContent=game.taxRate+"%";
});

$("sell").addEventListener("click",()=>{
  if(game.resources.wood<10){
    alert("Недостатньо деревини для продажу!");
    return;
  }

  game.resources.wood-=10;
  game.money+=2500;

  addLog("Продано 10 одиниць деревини за 2 500 ₴.");
  updateUI();
});

$("work").addEventListener("click",()=>{
  const jobs=game.buildings.reduce((sum,item)=>sum+item.jobs,0);

  if(jobs===0){
    alert("Спочатку побудуй підприємства!");
    return;
  }

  const income=Math.min(jobs,game.population)*15;

  game.money+=income;

  addLog("Економіка отримала "+income+" ₴ від роботи населення.");
  updateUI();
});

$("shop").addEventListener("click",()=>{
  if(game.money<5000){
    alert("Недостатньо коштів!");
    return;
  }

  game.money-=5000;
  game.happiness=Math.min(100,game.happiness+3);

  addLog("Підтримано торгівлю та добробут населення.");
  updateUI();
});

$("vote").addEventListener("click",()=>{
  if(!game.started) return;

  game.votes+=1;
  game.happiness=Math.min(100,game.happiness+1);

  addLog("Проведено громадське голосування.");
  $("peopleInfo").textContent=
    "Громадських голосувань: "+game.votes;

  updateUI();
});

$("election").addEventListener("click",()=>{
  const playerScore=game.happiness+game.buildings.length*2;
  const botScore=55+Math.random()*30;

  if(playerScore>=botScore){
    addLog("Вибори завершилися перемогою чинної влади.");
    game.happiness=Math.min(100,game.happiness+2);
  }else{
    addLog("На виборах перемогла опозиція. Уряд змінився.");
    game.happiness=Math.max(0,game.happiness-3);
  }

  updateUI();
});

function simulateBots(){
  game.bots.forEach(bot=>{
    bot.population*=1.0002;
    bot.money+=bot.population*0.002;
    bot.development+=0.03+Math.random()*0.04;
    bot.happiness+=Math.random()*0.4-0.2;

    if(bot.development>100){
      bot.development=100;
    }

    if(bot.happiness>100) bot.happiness=100;
    if(bot.happiness<20) bot.happiness=20;

    if(Math.random()<0.015){
      bot.cities++;
      addLog("Держава "+bot.name+" розвинула нове місто.");
    }
  });

  renderBots();
}

function growSettlements(){
  game.cities.forEach(city=>{
    city.population*=1.001;
  });

  game.villages.forEach(village=>{
    village.population*=1.002;

    if(village.population>=1500){
      game.cities.push({
        id:Date.now()+Math.random(),
        name:village.name,
        lat:village.lat,
        lon:village.lon,
        population:village.population,
        level:"Місто"
      });

      addLog("Село "+village.name+" отримало статус міста.");
      village.population=0;
    }
  });

  game.villages=game.villages.filter(village=>village.population>0);

  game.population=game.cities.reduce(
    (sum,city)=>sum+city.population,0
  )+game.villages.reduce(
    (sum,village)=>sum+village.population,0
  );

  drawSettlements();
}

function createVillage(){
  if(game.cities.length===0) return;

  const capital=game.cities[0];

  const names=[
    "Зелений Гай",
    "Нове Поле",
    "Діброва",
    "Сонячне",
    "Берегове",
    "Калинівка",
    "Долинське",
    "Лісове"
  ];

  const angle=Math.random()*Math.PI*2;
  const distanceFromCity=0.05+Math.random()*0.15;

  const village={
    name:names[Math.floor(Math.random()*names.length)],
    lat:capital.lat+Math.sin(angle)*distanceFromCity,
    lon:capital.lon+Math.cos(angle)*distanceFromCity,
    population:100+Math.floor(Math.random()*100)
  };

  game.villages.push(village);

  addLog("Засновано нове село: "+village.name+".");
  drawSettlements();
}

function dailySimulation(){
  if(!game.started || game.paused) return;

  game.day++;

  if(game.day>30){
    game.day=1;
    game.month++;

    if(game.month>12){
      game.month=1;
      game.year++;
    }
  }

  const taxIncome=game.population*game.taxRate*0.015;
  const buildingIncome=game.buildings.reduce(
    (sum,item)=>sum+item.income,0
  );

  const expenses=game.population*0.5+
    game.buildings.reduce((sum,item)=>sum+item.jobs*2,0);

  game.money+=taxIncome+buildingIncome-expenses;

  game.food+=game.buildings.filter(
    item=>item.id==="farm"
  ).length*80;

  game.food-=game.population*0.15;

  if(game.food<0){
    game.food=0;
    game.happiness=Math.max(0,game.happiness-2);
  }

  game.resources.wood+=game.buildings.filter(
    item=>item.id==="sawmill"
  ).length*5;

  game.resources.stone+=game.buildings.filter(
    item=>item.id==="quarry"
  ).length*5;

  game.resources.coal+=game.buildings.filter(
    item=>item.id==="mine"
  ).length*5;

  if(game.war){
    game.warDays++;

    game.money-=2000;
    game.happiness=Math.max(0,game.happiness-0.5);

    if(game.pontoonDays>0){
      game.pontoonDays--;
    }

    if(game.warDays>=30){
      game.war=false;
      addLog("Період конфлікту завершився. Почалося відновлення.");
    }
  }

  growSettlements();

  if(Math.random()<0.025 && game.villages.length<15){
    createVillage();
  }

  simulateBots();
  updateUI();

  if(Math.random()<0.08){
    addLog("Мешканці обговорюють розвиток держави.");
  }
}

function toggleWar(){
  if(game.war){
    game.war=false;
    addLog("Конфлікт завершено. Розпочато відновлення.");
  }else{
    game.war=true;
    game.warDays=0;
    addLog("Почався умовний період конфлікту. Економіка зазнає збитків.");
  }

  updateUI();
}

$("war").addEventListener("click",toggleWar);

$("peace").addEventListener("click",()=>{
  game.war=false;
  game.warDays=0;
  addLog("Укладено мир. Держава переходить до відновлення.");
  updateUI();
});

function updateWarInfo(){
  if(game.war){
    $("warText").textContent=
      "У країні триває умовний конфлікт. Економіка поступово втрачає ресурси.";
  }else{
    $("warText").textContent=
      "Країна перебуває в мирному стані.";
  }
}

function advanceTime(){
  for(let i=0;i<game.speed;i++){
    dailySimulation();
  }

  updateWarInfo();
}

$("pause").addEventListener("click",()=>{
  game.paused=!game.paused;

  $("pause").textContent=
    game.paused?"Продовжити":"Пауза";
});

$("speed").addEventListener("click",()=>{
  game.speed++;

  if(game.speed>5){
    game.speed=1;
  }

  $("speed").textContent="Швидкість: x"+game.speed;
});

function initializeInterface(){
  changeTab("build");

  $("taxVal").value=game.taxRate;

  $("taxVal").nextElementSibling.textContent=
    game.taxRate+"%";

  updateWarInfo();
}

function randomEvents(){
  if(!game.started || game.paused) return;

  const events=[
    {
      text:"Зросла торгівля між містами.",
      effect:()=>game.money+=3000
    },
    {
      text:"Урожай виявився вдалим.",
      effect:()=>game.food+=500
    },
    {
      text:"Населення задоволене розвитком країни.",
      effect:()=>game.happiness=Math.min(100,game.happiness+2)
    },
    {
      text:"Економіка переживає невеликий спад.",
      effect:()=>game.money=Math.max(0,game.money-2500)
    },
    {
      text:"До столиці прибули нові мешканці.",
      effect:()=>game.population+=30
    }
  ];

  const event=events[Math.floor(Math.random()*events.length)];

  event.effect();
  addLog("Подія: "+event.text);
  updateUI();
}

initializeInterface();

setInterval(()=>{
  if(game.started && !game.paused){
    advanceTime();
  }
},1000);

setInterval(randomEvents,15000);

</script>
</body>
</html>
