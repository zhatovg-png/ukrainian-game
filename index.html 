function createPontoon(city) {
    const pontoon = {
        id: Date.now() + Math.random(),
        cityId: city.id,
        name: "Понтонна переправа",
        remaining: 20
    };

    gameData.pontoons.push(pontoon);

    addHistory(
        "Для міста " + city.name +
        " створено тимчасову понтонну переправу."
    );
}

function updatePontoons() {
    gameData.pontoons.forEach(pontoon => {
        pontoon.remaining--;
    });

    const expired = gameData.pontoons.filter(
        pontoon => pontoon.remaining <= 0
    );

    expired.forEach(pontoon => {
        const city = gameData.cities.find(
            item => item.id === pontoon.cityId
        );

        if (city) {
            addHistory(
                "Тимчасова переправа міста " +
                city.name + " більше не діє."
            );
        }
    });

    gameData.pontoons = gameData.pontoons.filter(
        pontoon => pontoon.remaining > 0
    );
}

