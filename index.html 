function economyTick() {
    gameData.cities.forEach(city => {
        if (city.damaged) {
            return;
        }

        gameData.money += city.factories * 500;
        gameData.money += city.farms * 100;
    });

    gameData.shops.forEach(shop => {
        gameData.money += shop.income;
    });

    gameData.money = Math.max(
        0,
        Math.floor(gameData.money)
    );
}

function consumeFood() {
    const population = gameData.cities.reduce(
        (sum, city) => sum + city.population,
        0
    ) + gameData.villages.reduce(
        (sum, village) => sum + village.population,
        0
    );

    const demand = Math.max(
        1,
        Math.floor(population / 1000)
    );

    gameData.resources.food -= demand;

    if (gameData.resources.food < 0) {
        gameData.resources.food = 0;

        gameData.cities.forEach(city => {
            city.happiness = Math.max(
                0,
                city.happiness - 2
            );
        });

        addHistory("У країні виник дефіцит продовольства.");
    }
}

function updateCityDevelopment() {
    gameData.cities.forEach(city => {
        if (city.damaged && gameData.war.active) {
            city.population = Math.max(
                0,
                city.population - 1
            );
        }
    });

    populationGrowth();
}

// =====================================
// ІГРОВИЙ ЧАС
// =====================================

function gameTick() {
    if (!gameData.started) return;

    gameData.tick++;

    updateCityDevelopment();

    extractResources();

    economyTick();

    if (gameData.tick % 10 === 0) {
        consumeFood();
    }

    if (gameData.tick % 15 === 0) {
        gameData.year++;

        addHistory(
            "Настав " + gameData.year + " рік."
        );
    }

    if (gameData.tick % 8 === 0 && gameData.war.active) {
        warEvent();
    }

    updatePontoons();

    updateAllPanels();

    updateLogistics();

    updateWarPanel();

    if (gameData.tick % 5 === 0) {
        saveGame();
    }
}

// =====================================
// ЗБЕРЕЖЕННЯ ГРИ
// =====================================

function saveGame() {
    try {
        const data = JSON.stringify(gameData);

        localStorage.setItem(
            "moja_ukraina_save",
            data
        );

        gameData.lastSave = Date.now();

        return true;
    } catch (error) {
        console.error("Помилка збереження:", error);
        return false;
    }
}

function loadGame() {
    try {
        const saved = localStorage.getItem(
            "moja_ukraina_save"
        );

        if (!saved) return false;

        const data = JSON.parse(saved);

        if (!data || typeof data !== "object") {
            return false;
        }

        gameData.country = data.country || "";
        gameData.year = Number(data.year) || 2016;
        gameData.money = Number(data.money) || 0;
        gameData.cities = Array.isArray(data.cities) ? data.cities : [];
        gameData.villages = Array.isArray(data.villages) ? data.villages : [];
        gameData.resources = data.resources || gameData.resources;
        gameData.workers = Array.isArray(data.workers) ? data.workers : [];
        gameData.shops = Array.isArray(data.shops) ? data.shops : [];
        gameData.buildings = Array.isArray(data.buildings) ? data.buildings : [];
        gameData.history = Array.isArray(data.history) ? data.history : [];
        gameData.pontoons = Array.isArray(data.pontoons) ? data.pontoons : [];
        gameData.war = data.war || gameData.war;
        gameData.elections = data.elections || gameData.elections;
        gameData.tick = Number(data.tick) || 0;
        gameData.started = true;

        gameData.cities.forEach(city => {
            city.buildings = Array.isArray(city.buildings)
                ? city.buildings : [];

            city.factories = Number(city.factories) || 0;
            city.farms = Number(city.farms) || 0;
            city.bridges = Number(city.bridges) || 0;
            city.roads = Number(city.roads) || 0;
        });

        return true;
    } catch (error) {
        console.error("Помилка завантаження:", error);
        return false;
    }
}

// =====================================
// ВІДНОВЛЕННЯ КАРТИ
// =====================================

function restoreMapMarkers() {
    gameData.cities.forEach(city => {
        const marker = L.marker([city.lat, city.lng])
            .addTo(map)
            .bindPopup(
                `<b>${escapeHTML(city.name)}</b><br>` +
                `Населення: ${Math.floor(city.population)}`
            );

        mapMarkers.push(marker);
    });

    gameData.villages.forEach(village => {
        const marker = L.circleMarker(
            [village.lat, village.lng],
            {
                radius: 6,
                color: "#267b39",
                fillColor: "#72d77d",
                fillOpacity: 1
            }
        )
        .addTo(map)
        .bindPopup(
            `<b>${escapeHTML(village.name)}</b><br>` +
            `Населення: ${Math.floor(village.population)}`
        );

        mapMarkers.push(marker);
    });
}

// =====================================
// ЗАПУСК ЗБЕРЕЖЕНОЇ ГРИ
// =====================================

function resumeGame() {
    if (!loadGame()) return;

    document.getElementById("startScreen").style.display = "none";
    document.getElementById("game").style.display = "block";

    document.getElementById("countryTitle").textContent =
        "🇺🇦 " + gameData.country;

    initializeMap();
    restoreMapMarkers();

    if (gameData.cities.length > 0) {
        selectCity(gameData.cities[0].id);

        document.getElementById("mainCity").textContent =
            "Головне місто: " + gameData.cities[0].name;
    }

    addHistory("Збережену гру відновлено.");

    updateAllPanels();
    updateWarPanel();
    updateLogistics();

    window.setInterval(gameTick, 3000);
}

// =====================================
// ФІНАЛЬНА ІНІЦІАЛІЗАЦІЯ
// =====================================

const previousStartGame = startGame;

startGame = function() {
    previousStartGame();

    if (gameData.started && map) {
        updateAllPanels();
        updateWarPanel();
        updateLogistics();
        saveGame();
    }
};

window.addEventListener("beforeunload", saveGame);

const continueButton = document.createElement("button");

continueButton.textContent = "ПРОДОВЖИТИ ГРУ";

continueButton.onclick = resumeGame;

document.querySelector(".startBox").appendChild(continueButton);

const resourceMarkers = [];

function showResourceMarkers() {
    if (!map) return;

    resourceSites.forEach(site => {
        const marker = L.circleMarker(
            [site.lat, site.lng],
            {
                radius: 7,
                color: "#805b12",
                fillColor: "#f5c542",
                fillOpacity: 0.9
            }
        ).addTo(map);

        marker.bindPopup(
            "⛏ " + escapeHTML(site.name) +
            "<br>Ресурс: " + escapeHTML(site.type)
        );

        resourceMarkers.push(marker);
    });
}

const originalInitializeMap = initializeMap;

initializeMap = function() {
    originalInitializeMap();

    if (resourceMarkers.length === 0) {
        showResourceMarkers();
    }
};

// =====================================
// КІНЕЦЬ ГРИ
// =====================================

</script>
