function addRoad(x1,y1,x2,y2) {
  const curveX = (x1+x2)/2;
  const curveY = (y1+y2)/2 - 12;

  const path = `M${x1} ${y1} Q${curveX} ${curveY} ${x2} ${y2}`;

  addMapShape(roadsLayer,"path",{
    d:path,
    fill:"none",
    stroke:"#8b7554",
    "stroke-width":9,
    "stroke-linecap":"round"
  });

  addMapShape(roadsLayer,"path",{
    d:path,
    fill:"none",
    stroke:"#e7d6a9",
    "stroke-width":4,
    "stroke-linecap":"round",
    "stroke-dasharray":"10 7"
  });
}

// АВТОМАТИЧНІ ДОРОГИ МІЖ МІСТАМИ ОДНІЄЇ ДЕРЖАВИ

worldCountries.forEach(country=>{
  const cities = worldCities.filter(city=>city.country===country.name);

  for(let i=0;i<cities.length-1;i++){
    addRoad(
      cities[i].x,
      cities[i].y,
      cities[i+1].x,
      cities[i+1].y
    );
  }
});

