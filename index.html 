function startElection() {
    if (gameData.cities.length === 0) {
        alert("Спочатку заснуй місто!");
        return;
    }

    if (gameData.elections.active) {
        alert("Вибори вже проводяться!");
        return;
    }

    gameData.elections.active = true;

    const totalPopulation = gameData.cities.reduce(
        (sum, city) => sum + city.population,
        0
    );

    const voters = Math.floor(totalPopulation * 0.7);

    gameData.elections.playerVotes = Math.floor(
        voters * (0.35 + Math.random() * 0.35)
    );

    gameData.elections.rivalVotes =
        voters - gameData.elections.playerVotes;

    const playerWins =
        gameData.elections.playerVotes >
        gameData.elections.rivalVotes;

    gameData.elections.active = false;
    gameData.elections.lastElection = gameData.year;

    if (playerWins) {
        addHistory("Вітаємо! Ти переміг на виборах!");
        gameData.money += 15000;
    } else {
        addHistory("На виборах переміг конкурент.");
    }

    updatePolitics();
    updateInterface();
}

