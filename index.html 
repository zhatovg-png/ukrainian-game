<script>
// ЧАСТИНА 1 — КАРТА ТА ОСНОВА

const worldMap = document.getElementById("worldMap");
const markerLayer = document.getElementById("mapMarkers");
const miniMarker = document.getElementById("miniMarker");

let selectedLocation = null;
let markerElement = null;
let draggingMarker = false;
let gameStarted = false;

function getMapCoordinates(event){
 const point = worldMap.createSVGPoint();
 point.x = event.clientX;
 point.y = event.clientY;
 const matrix = worldMap.getScreenCTM();
 if(!matrix) return null;
 return point.matrixTransform(matrix.inverse());
}

function updateMarkerPosition(x,y){
 x=Math.max(10,Math.min(1190,x));
 y=Math.max(10,Math.min(790,y));

 markerElement.setAttribute("transform",`translate(${x},${y})`);
 selectedLocation={x:Math.round(x),y:Math.round(y)};

 document.getElementById("chosenPlace").textContent=
 "Обране місце: "+selectedLocation.x+", "+selectedLocation.y;

 document.getElementById("foundBtn").disabled=false;

 document.getElementById("mapMessage").textContent=
 "Мітку встановлено!";

 miniMarker.innerHTML=
 '<circle cx="'+x+'" cy="'+y+'" r="27" fill="#e53935" stroke="white" stroke-width="10"/>';
}

function createMapMarker(x,y){
 if(markerElement) markerElement.remove();

 markerElement=document.createElementNS("http://www.w3.org/2000/svg","g");

 const outer=document.createElementNS("http://www.w3.org/2000/svg","circle");
 outer.setAttribute("r","16");
 outer.setAttribute("fill","#e53935");
 outer.setAttribute("stroke","white");
 outer.setAttribute("stroke-width","4");

 const inner=document.createElementNS("http://www.w3.org/2000/svg","circle");
 inner.setAttribute("r","5");
 inner.setAttribute("fill","white");

 markerElement.append(outer,inner);
 markerLayer.appendChild(markerElement);

 markerElement.addEventListener("pointerdown",function(event){
  event.preventDefault();
  event.stopPropagation();
  draggingMarker=true;
  markerElement.setPointerCapture(event.pointerId);
 });

 markerElement.addEventListener("pointermove",function(event){
  if(!draggingMarker)return;
  const point=getMapCoordinates(event);
  if(point)updateMarkerPosition(point.x,point.y);
 });

 markerElement.addEventListener("pointerup",function(){
  draggingMarker=false;
 });

 markerElement.addEventListener("pointercancel",function(){
  draggingMarker=false;
 });

 updateMarkerPosition(x,y);
}

worldMap.addEventListener("pointerdown",function(event){
 if(gameStarted)return;
 if(event.target.closest("#mapMarkers"))return;
 const point=getMapCoordinates(event);
 if(point)createMapMarker(point.x,point.y);
});

document.querySelectorAll(".tabs button").forEach(button=>{
 button.addEventListener("click",()=>{
  document.querySelectorAll(".tabs button").forEach(b=>b.classList.remove("active"));
  document.querySelectorAll(".tabContent").forEach(s=>s.classList.remove("active"));
  button.classList.add("active");
  document.getElementById(button.dataset.tab).classList.add("active");
 });
});

// КІНЕЦЬ ЧАСТИНИ 1
</script>
