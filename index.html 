function declareWar(countryId){
 const country=botCountries.find(c=>c.id===countryId);

 if(!country||country.owner==="player"||country.atWar)return;

 if(game.wars.some(w=>w.active&&
  (w.attacker===countryId||w.defender===countryId))){
  showEvent("Ця держава вже бере участь у війні.");
  return;
 }

 if(game.money<100000){
  showEvent("Для початку війни потрібен державний резерв 100 000 ₴.");
  return;
 }

 game.money-=100000;

 const war={
  id:Date.now()+Math.floor(Math.random()*10000),
  attacker:game.territory,
  defender:countryId,
  active:true,
  duration:0,
  progress:0,
  attackerScore:0,
  defenderScore:0
 };

 game.wars.push(war);
 country.atWar=true;
 country.relation=-100;

 showEvent("Почалася війна між "+game.country+" та "+country.name+".");
 renderAll();
 renderWars();
}

function processWars(){
 game.wars.forEach(war=>{
  if(!war.active)return;

  war.duration++;

  const attacker=botCountries.find(c=>c.id===war.attacker);
  const defender=botCountries.find(c=>c.id===war.defender);

  if(!attacker||!defender)return;

  // Абстрактний розрахунок перебігу війни
  const attackValue=game.budgets.defense+
   Math.random()*10+game.happiness/10;

  const defenseValue=defender.strength/10+
   Math.random()*10;

  war.progress+=attackValue-defenseValue;

  war.progress=Math.max(-100,Math.min(100,war.progress));

  war.attackerScore=Math.max(0,war.progress);
  war.defenderScore=Math.max(0,-war.progress);

  game.money=Math.max(0,game.money-1000);

  game.happiness=Math.max(0,game.happiness-0.04);

  if(war.duration>=60){
   finishWar(war,war.progress>=0);
  }
 });
}

function finishWar(war,attackerWins){
 const defender=botCountries.find(c=>c.id===war.defender);

 if(!defender)return;

 war.active=false;
 defender.atWar=false;

 if(attackerWins){
  defender.strength=Math.max(10,defender.strength-8);
  defender.money=Math.floor(defender.money*0.85);
  game.money+=50000;

  // Територія переходить під контроль переможця
  mapState.occupied[war.defender]=war.attacker;

  showEvent("Перемога! Територія "+defender.name+
   " перейшла під контроль "+game.country+".");
 }else{
  game.money=Math.max(0,game.money-50000);
  game.happiness=Math.max(0,game.happiness-5);
  showEvent("Війна завершилася без перемоги твоєї держави.");
 }

 drawWorld();
 renderAll();
 renderWars();
}

