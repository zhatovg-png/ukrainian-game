function updateWarMap(){
 drawWorld();

 const polygons=document.querySelectorAll("#territories polygon");

 polygons.forEach(poly=>{
  const id=Number(poly.dataset.id);
  const attackerId=mapState.occupied[id];

  if(attackerId===undefined)return;

  const attacker=botCountries.find(c=>c.id===attackerId);

  if(attacker){
   poly.setAttribute("fill",attacker.color);
   poly.setAttribute("stroke","#facc15");
   poly.setAttribute("stroke-width","4");
  }
 });

 const labels=document.querySelectorAll("#mapLabels text");

 labels.forEach(label=>{
  const centerX=Number(label.getAttribute("x"));
  const territory=territories.find(t=>{
   const c=territoryCenter(t.points);
   return Math.abs(c.x-centerX)<1;
  });

  if(!territory)return;

  if(mapState.occupied[territory.id]!==undefined){
   const owner=botCountries.find(c=>
    c.id===mapState.occupied[territory.id]
   );

   if(owner){
    label.textContent="Контроль: "+owner.name;
   }
  }
 });
}

