function saveGame(){
 if(!game.started){
  showEvent("Спочатку створи державу.");
  return;
 }

 const data={
  game:game,
  botCountries:botCountries,
  mapState:mapState,
  selectedPlace:selectedPlace
 };

 try{
  localStorage.setItem("nova_epoha_save",JSON.stringify(data));
  showEvent("Гру успішно збережено.");
 }catch(error){
  showEvent("Не вдалося зберегти гру.");
 }
}

function loadGame(){
 try{
  const raw=localStorage.getItem("nova_epoha_save");

  if(!raw)return false;

  const data=JSON.parse(raw);

  if(!data||!data.game||!data.botCountries)return false;

  Object.assign(game,data.game);

  botCountries.splice(
   0,
   botCountries.length,
   ...data.botCountries
  );

  if(data.mapState){
   Object.assign(mapState,data.mapState);
  }

  selectedPlace=data.selectedPlace;

  if(game.started){
   document.getElementById("setup").style.display="none";
   document.getElementById("countryTitle").textContent=
    "🏛 "+game.country;

   document.getElementById("capitalTitle").textContent=
    "Столиця: "+game.capital;

   renderAll();
   updateWarMap();
   setGameSpeed(game.speed||1);
  }

  return true;
 }catch(error){
  console.error("Помилка завантаження:",error);
  return false;
 }
}

document.getElementById("saveBtn").addEventListener("click",saveGame);

