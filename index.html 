function showSection(id) {
    const sections = document.querySelectorAll("#game > .panel");

    sections.forEach(section => {
        section.style.display = section.id === id ? "block" : "none";
    });

    const target = document.getElementById(id);

    if (target) {
        target.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    }
}

function getSelectedCity() {
    if (!gameData.selectedCity) {
        alert("Спочатку обери місто!");
        return null;
    }

    return gameData.selectedCity;
}

function updateBuildMenu() {
    const container = document.getElementById("buildContent");

    if (!container) return;

    const city = gameData.selectedCity;

    if (!city) {
        container.textContent = "Спочатку обери місто.";
        return;
    }

    let html = `<h4>Місто: ${escapeHTML(city.name)}</h4>`;

    Object.entries(buildingTypes).forEach(([key, building]) => {
        html += `
            <div class="panel">
                <b>${escapeHTML(building.name)}</b>
                <p>Ціна: ${building.price.toLocaleString("uk-UA")} ₴</p>
                <p>Деревина: ${building.wood} | Камінь: ${building.stone}</p>
                <button onclick="buildStructure('${key}')">
                    Побудувати
                </button>
            </div>
        `;
    });

    container.innerHTML = html;
}

function buildStructure(type) {
    const city = getSelectedCity();

    if (!city) return;

    const building = buildingTypes[type];

    if (!building) return;

    if (gameData.money < building.price) {
        alert("Недостатньо гривень!");
        return;
    }

    if (gameData.resources.wood < building.wood ||
        gameData.resources.stone < building.stone) {
        alert("Недостатньо будівельних ресурсів!");
        return;
    }

    if (type === "port") {
        const nearWater = city.lng >= 28 && city.lng <= 38 &&
            city.lat <= 48;

        if (!nearWater) {
            alert("Для морського порту потрібне узбережжя.");
            return;
        }
    }

    if (type === "bridge") {
        const nearRiver = city.lat >= 46 && city.lat <= 52;

        if (!nearRiver) {
            alert("Поблизу немає відповідної річкової ділянки.");
            return;
        }
    }

    gameData.money -= building.price;
    gameData.resources.wood -= building.wood;
    gameData.resources.stone -= building.stone;

    city.buildings.push({
        type: type,
        name: building.name,
        builtAt: Date.now()
    });

    if (type === "farm") city.farms++;
    if (type === "factory") city.factories++;
    if (type === "bridge") city.bridges++;
    if (type === "road") city.roads++;

    if (type === "house") {
        city.population += building.population;
    }

    addHistory(
        "У місті " + city.name +
        " збудовано: " + building.name
    );

    updateInterface();
    updateBuildMenu();
    updateEconomy();
    updateResources();
}

function financeVillage(index, amount) {
    const village = gameData.villages[index];

    if (!village || !Number.isFinite(amount) || amount <= 0) {
        return;
    }

    if (gameData.money < amount) {
        alert("Недостатньо гривень!");
        return;
    }

    gameData.money -= amount;

    village.population += Math.floor(amount / 100);

    village.happiness = Math.min(100, village.happiness + 5);

    addHistory(
        "Країна профінансувала село " + village.name
    );

    updateInterface();
    updateEconomy();
}

