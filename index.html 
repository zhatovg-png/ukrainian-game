      }
      #gameControlPanel button {
        padding:8px 6px;
        font-size:12px;
      }
    }
  `;
  document.head.appendChild(style);

  const panel = document.createElement("section");
  panel.id = "gameControlPanel";
  panel.innerHTML = `
    <h3>🏛️ Керування державою</h3>
    <div id="gameClock">📅 2016 рік · Січень</div>

    <div class="game-section">
      <b id="gameCountryName">Держава ще не заснована</b>
      <div class="game-stat"><span>Населення</span><b id="statPopulation">—</b></div>
      <div class="game-stat"><span>Казна</span><b id="statTreasury">—</b></div>
      <div class="game-stat"><span>Їжа</span><b id="statFood">—</b></div>
      <div class="game-stat"><span>Деревина</span><b id="statWood">—</b></div>
      <div class="game-stat"><span>Камінь</span><b id="statStone">—</b></div>
      <div class="game-stat"><span>Залізо</span><b id="statIron">—</b></div>
    </div>

    <div class="game-section">
      <b>🏗️ Будівництво</b>
      <button data-build="houses">Будинок</button>
      <button data-build="farms">Ферма</button>
      <button data-build="sawmills">Лісопилка</button>
      <button data-build="quarries">Кар'єр</button>
    </div>

    <div class="game-section">
      <b>💰 Торгівля</b>
      <select id="tradeResource">
        <option value="food">Їжа</option>
        <option value="wood">Деревина</option>
        <option value="stone">Камінь</option>
        <option value="iron">Залізо</option>
      </select>
      <input id="tradeAmount" type="number" min="1" max="1000" value="10">
      <button id="buyResource">Купити</button>
      <button id="sellResource">Продати</button>
    </div>

    <div class="game-section">
      <b>🌍 Дипломатія</b>
      <select id="diplomacyCountry"></select>
      <button id="improveRelations">Покращити відносини</button>
      <button id="makeAlliance">Запропонувати союз</button>
    </div>

    <div class="game-section">
      <b>🏛️ Податки</b>
      <input id="taxInput" type="number" min="0" max="30" value="10">
      <button id="setTax">Встановити податок</button>
      <button id="collectTax">Зібрати податки</button>
    </div>

    <div class="game-section">
      <button id="pauseGame">⏸️ Пауза</button>
      <button id="saveGame">💾 Зберегти</button>
      <button id="loadGame">📂 Завантажити</button>
    </div>

    <div class="game-message" id="gameMessage"></div>
  `;

  document.body.appendChild(panel);

  const $ = id => document.getElementById(id);

  function message(text) {
    $("gameMessage").textContent = text;
  }

  function getPlayer() {
    return window.playerCountry || null;
  }

  function formatNumber(value) {
    return Number(value || 0).toLocaleString("uk-UA");
  }

  function updateStatistics() {
    const player = getPlayer();

    if (!player) {
      $("gameCountryName").textContent = "Держава ще не заснована";
      return;
    }

    $("gameCountryName").textContent =
      "🏳️ " + player.name + " · " + player.capital;

    $("statPopulation").textContent = formatNumber(player.population);
    $("statTreasury").textContent =
      formatNumber(player.treasury) + " ₴";
    $("statFood").textContent = formatNumber(player.food);
    $("statWood").textContent = formatNumber(player.wood);
    $("statStone").textContent = formatNumber(player.stone);
    $("statIron").textContent = formatNumber(player.iron);
  }

  function updateDiplomacyList() {
    const select = $("diplomacyCountry");
    const previous = select.value;

    select.innerHTML = "";

    (window.worldStates || []).forEach(state => {
      const option = document.createElement("option");
      option.value = state.id;
      option.textContent = state.name;
      select.appendChild(option);
    });

    if (previous) select.value = previous;
  }

  function currentMonthName() {
    const months = [
      "Січень", "Лютий", "Березень", "Квітень",
      "Травень", "Червень", "Липень", "Серпень",
      "Вересень", "Жовтень", "Листопад", "Грудень"
    ];

    return months[gameMonth - 1];
  }

  function updateClock() {
    $("gameClock").textContent =
      "📅 " + gameYear + " рік · " + currentMonthName();
  }

  function advanceTime() {
    if (paused) return;

    gameMonth++;

    if (gameMonth > 12) {
      gameMonth = 1;
      gameYear++;

      if (getPlayer()) {
        getPlayer().year = gameYear;
      }

      message("Настав новий рік: " + gameYear);
    }

    if (typeof window.runCityDevelopment === "function") {
      window.runCityDevelopment();
    }

    if (typeof window.developBotCountries === "function") {
      window.developBotCountries();
    }

    updateClock();
    updateStatistics();
  }

  function saveGame() {
    const data = {
      version: 1,
      gameMonth,
      gameYear,
      playerCountry: window.playerCountry || null,
      worldStates: window.worldStates || [],
      worldDiplomacy: window.worldDiplomacy || {},
      cityWorld: window.cityWorld || [],
      worldTradeHistory: window.worldTradeHistory || [],
      worldEvents: window.worldEvents || []
    };

    try {
      localStorage.setItem(SAVE_KEY, JSON.stringify(data));
      message("Гру успішно збережено!");
    } catch (error) {
      console.error("Помилка збереження:", error);
      message("Не вдалося зберегти гру на цьому пристрої.");
    }
  }

  function drawRestoredCountry(player) {
    if (!player) return;

    const map = $("worldMap");
    const territories = $("territories");
    const settlements = $("settlements");
    const labels = $("mapLabels");

    if (!map || !territories || !settlements || !labels) return;

    const ns = "http://www.w3.org/2000/svg";

    const border = document.createElementNS(ns, "polygon");
    const coords = [
      [-100,-55],[-55,-100],[15,-95],[90,-60],
      [110,0],[75,70],[10,100],[-75,75],[-110,10]
    ];

    border.setAttribute("points", coords.map(([dx, dy]) =>
      (player.x + dx) + "," + (player.y + dy)
    ).join(" "));

    border.setAttribute("fill", player.color || "#e3a342");
    border.setAttribute("fill-opacity", ".28");
    border.setAttribute("stroke", player.color || "#e3a342");
    border.setAttribute("stroke-width", "4");
    territories.appendChild(border);

    const capital = document.createElementNS(ns, "circle");
    capital.setAttribute("cx", player.x);
    capital.setAttribute("cy", player.y);
    capital.setAttribute("r", "12");
    capital.setAttribute("fill", "#f5c542");
    capital.setAttribute("stroke", "#fff");
    capital.setAttribute("stroke-width", "3");
    settlements.appendChild(capital);

    const label = document.createElementNS(ns, "text");
    label.setAttribute("x", player.x + 17);
    label.setAttribute("y", player.y - 15);
    label.setAttribute("fill", "#fff2b2");
    label.setAttribute("font-size", "15");
    label.setAttribute("font-weight", "bold");
    label.setAttribute("paint-order", "stroke");
    label.setAttribute("stroke", "#18232d");
    label.setAttribute("stroke-width", "4");
    label.textContent = "★ " + player.capital;
    labels.appendChild(label);
  }

  function loadGame() {
    try {
      const raw = localStorage.getItem(SAVE_KEY);

      if (!raw) {
        message("Збереження не знайдено.");
        return;
      }

      const data = JSON.parse(raw);

      if (!data || data.version !== 1) {
        message("Формат збереження не підтримується.");
        return;
      }

      gameMonth = Math.max(1, Math.min(12, Number(data.gameMonth) || 1));
      gameYear = Math.max(2016, Number(data.gameYear) || 2016);

      window.playerCountry = data.playerCountry || null;
      window.worldDiplomacy = data.worldDiplomacy || {};
      window.cityWorld = data.cityWorld || [];
      window.worldTradeHistory = data.worldTradeHistory || [];
      window.worldEvents = data.worldEvents || [];

      if (Array.isArray(data.worldStates) && window.worldStates) {
        data.worldStates.forEach(savedState => {
          const current = window.worldStates.find(
            state => state.id === savedState.id
          );

          if (current) {
            current.population = savedState.population;
            current.economy = savedState.economy;
          }
        });
      }

      const modal = $("setupModal");
      if (modal && window.playerCountry) {
        modal.style.display = "none";
      }

      drawRestoredCountry(window.playerCountry);
      updateDiplomacyList();
      updateStatistics();
      updateClock();

      message("Збереження завантажено!");
    } catch (error) {
      console.error("Помилка завантаження:", error);
      message("Помилка читання збереження.");
    }
  }

  panel.querySelectorAll("[data-build]").forEach(button => {
    button.addEventListener("click", () => {
      if (typeof window.buildCityBuilding !== "function") {
        message("Система будівництва недоступна.");
        return;
      }

      const result = window.buildCityBuilding(button.dataset.build);
      message(result);
      updateStatistics();
    });
  });

  $("buyResource").addEventListener("click", () => {
    const result = window.tradeResources(
      $("tradeResource").value,
      $("tradeAmount").value,
      "buy"
    );

    message(result);
    updateStatistics();
  });

  $("sellResource").addEventListener("click", () => {
    const result = window.tradeResources(
      $("tradeResource").value,
      $("tradeAmount").value,
      "sell"
    );

    message(result);
    updateStatistics();
  });

  $("improveRelations").addEventListener("click", () => {
    const result = window.changeDiplomacy(
      $("diplomacyCountry").value,
      20
    );

    message(result);
  });

  $("makeAlliance").addEventListener("click", () => {
    const result = window.createAlliance(
      $("diplomacyCountry").value
    );

    message(result);
  });

  $("setTax").addEventListener("click", () => {
    const result = window.setTaxRate($("taxInput").value);
    message(result);
  });

  $("collectTax").addEventListener("click", () => {
    const result = window.collectTaxes();
    message(result);
    updateStatistics();
  });

  $("pauseGame").addEventListener("click", () => {
    paused = !paused;
    $("pauseGame").textContent =
      paused ? "▶️ Продовжити" : "⏸️ Пауза";
    message(paused ? "Гру призупинено." : "Гру продовжено.");
  });

  $("saveGame").addEventListener("click", saveGame);
  $("loadGame").addEventListener("click", loadGame);

  // Під'єднуємо кнопки першої частини
  const oldSaveButton = $("saveBtn");
  if (oldSaveButton) {
    oldSaveButton.addEventListener("click", saveGame);
  }

  const oldPauseButton = $("pauseBtn");
  if (oldPauseButton) {
    oldPauseButton.addEventListener("click", () => {
      paused = !paused;
      message(paused ? "Гру призупинено." : "Гру продовжено.");
    });
  }

  updateDiplomacyList();
  updateStatistics();
  updateClock();

  // Автоматичне завантаження збереження
  if (localStorage.getItem(SAVE_KEY)) {
    loadGame();
  }

  // Один ігровий місяць кожні 30 секунд
  gameTimer = setInterval(advanceTime, 30000);

  // Оновлюємо статистику після заснування держави
  const foundButton = $("foundBtn");
  if (foundButton) {
    foundButton.addEventListener("click", () => {
      setTimeout(() => {
        updateStatistics();
        updateDiplomacyList();
      }, 100);
    });
  }

  console.log("Частина 6 завантажена: гра готова");
})();
