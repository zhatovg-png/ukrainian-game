    },
    {
      name: "Союз Нордвік",
      color: "#5998bd",
      points: [
        [0.34,0.12],[0.55,0.10],[0.65,0.25],
        [0.56,0.39],[0.39,0.32]
      ],
      capital: "Нордбург",
