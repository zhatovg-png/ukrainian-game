<script>
const worldMap = document.getElementById("worldMap");
const markerLayer = document.getElementById("mapMarkers");
const miniMarker = document.getElementById("miniMarker");

let selectedLocation = null;
let markerElement = null;
let gameStarted = false;

window.selectedLocation = null;
window.gameStarted = false;

const SVG_NS = "http://www.w3.org/2000/svg";

function getMapCoordinates(element,event){
  const rect=element.getBoundingClientRect();
  const view=element.viewBox.baseVal;

  if(!rect.width||!rect.height)return null;

  const x=(event.clientX-rect.left)/rect.width*view.width;
  const y=(event.clientY-rect.top)/rect.height*view.height;

  return {
    x:Math.max(0,Math.min(view.width,x)),
    y:Math.max(0,Math.min(view.height,y))
  };
}

function updateMarkerPosition(x,y){
  selectedLocation={x,y};
  window.selectedLocation={x,y};

  if(!markerElement){
    markerElement=document.createElementNS(SVG_NS,"g");
    markerElement.setAttribute("class","selected-map-marker");
    markerElement.setAttribute("pointer-events","none");

    const pin=document.createElementNS(SVG_NS,"path");
    pin.setAttribute("d","M0 8 L-10 27 L10 27 Z");
    pin.setAttribute("fill","#ff4138");
    pin.setAttribute("stroke","#fff");
    pin.setAttribute("stroke-width","3");

    const outer=document.createElementNS(SVG_NS,"circle");
    outer.setAttribute("r","17");
    outer.setAttribute("fill","#ff4138");
    outer.setAttribute("fill-opacity",".35");
    outer.setAttribute("stroke","#fff");
    outer.setAttribute("stroke-width","3");

    const inner=document.createElementNS(SVG_NS,"circle");
    inner.setAttribute("r","6");
    inner.setAttribute("fill","#ff4138");
    inner.setAttribute("stroke","#fff");
    inner.setAttribute("stroke-width","2");

    markerElement.append(pin,outer,inner);
    markerLayer.appendChild(markerElement);
  }

  markerElement.setAttribute("transform",`translate(${x} ${y})`);

  const markerHTML=`
    <circle cx="${x}" cy="${y}" r="25"
      fill="#ff4138" fill-opacity=".3"
      stroke="#fff" stroke-width="7"/>
    <circle cx="${x}" cy="${y}" r="10"
      fill="#ff4138" stroke="#fff" stroke-width="5"/>
  `;

  miniMarker.innerHTML=markerHTML;

  const setupMarker=document.getElementById("setupMiniMarker");
  if(setupMarker)setupMarker.innerHTML=markerHTML;
}

function createMapMarker(x,y){
  updateMarkerPosition(x,y);
}

function selectMapPoint(element,event){
  if(window.gameStarted)return;
  event.preventDefault();

  const point=getMapCoordinates(element,event);
  if(!point)return;

  createMapMarker(point.x,point.y);
}

worldMap.addEventListener("pointerdown",event=>{
  if(event.target.closest && event.target.closest(".map-resource"))return;
  selectMapPoint(worldMap,event);
});

document.getElementById("miniMap").addEventListener("pointerdown",event=>{
  selectMapPoint(event.currentTarget,event);
});

document.getElementById("setupMiniMap").addEventListener("pointerdown",event=>{
  selectMapPoint(event.currentTarget,event);
});

function showMessage(message){
  let box=document.getElementById("foundingMessage");

  if(!box){
    box=document.createElement("div");
    box.id="foundingMessage";
    document.body.appendChild(box);
  }

  box.textContent=message;
  box.style.display="block";

  clearTimeout(window.foundingMessageTimer);
  window.foundingMessageTimer=setTimeout(()=>{
    box.style.display="none";
  },3000);
}

console.log("Частина 1 завантажена");
</script>

