<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Нова Епоха — Світова стратегія</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#101820;color:#f1f5f9;
 font-family:Arial,sans-serif
}
header{
 padding:13px;background:#172633;border-bottom:1px solid #34495e;
 display:flex;justify-content:space-between;align-items:center;gap:10px;
 flex-wrap:wrap
}
h1{font-size:20px;margin:0;color:#facc15}
button,select,input{
 border:1px solid #526579;border-radius:8px;padding:10px;
 background:#263849;color:white;font-size:14px
}
button{cursor:pointer;background:#245b83}
button:disabled{opacity:.45;cursor:not-allowed}
button:active{transform:scale(.98)}
.layout{
 display:grid;grid-template-columns:minmax(0,1fr) 310px;
 gap:10px;padding:10px
}
.panel{
 background:#172633;border:1px solid #34495e;
 border-radius:10px;padding:12px;margin-bottom:10px
}
#mapWrap{
 position:relative;background:#172d36;border-radius:10px;
 overflow:hidden;border:1px solid #526579;min-height:440px
}
#worldMap{width:100%;height:100%;min-height:440px;display:block}
.map-label{
 fill:#fff;font-size:13px;font-weight:bold;
 paint-order:stroke;stroke:#18232c;stroke-width:3px;
 stroke-linejoin:round;pointer-events:none
}
.map-small{
 fill:#e2e8f0;font-size:10px;
 paint-order:stroke;stroke:#18232c;stroke-width:2px;
 pointer-events:none
}
.map-border{fill:none;stroke:#f8fafc;stroke-width:2;stroke-dasharray:5 3}
.map-river{fill:none;stroke:#55c8ee;stroke-width:4;stroke-linecap:round}
.map-road{fill:none;stroke:#d6b77b;stroke-width:2;stroke-dasharray:5 4}
.map-city{stroke:#fff;stroke-width:1.5}
#mapHint{
 position:absolute;left:10px;bottom:10px;
 background:#101820dd;padding:8px;border-radius:7px;font-size:12px
}
.stats{
 display:grid;grid-template-columns:repeat(3,1fr);gap:7px
}
.stat{background:#263849;border-radius:8px;padding:9px}
.stat small{display:block;color:#a9bac9;font-size:11px}
.stat strong{font-size:16px}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.tabs button{flex:1;min-width:85px}
.tabContent{display:none}
.tabContent.active{display:block}
.item{
 background:#263849;padding:10px;border-radius:8px;
 margin:7px 0;border:1px solid #40576b
}
.item h3{font-size:15px;margin:0 0 6px}
.item p{font-size:13px;color:#cbd5e1;margin:5px 0}
.item button{margin-top:6px}
.good{color:#86efac}
.bad{color:#fca5a5}
.muted{color:#a9bac9}
#setup{
 position:fixed;inset:0;background:#07111aee;z-index:10;
 display:flex;align-items:center;justify-content:center;padding:15px
}
#setupBox{
 width:min(440px,100%);background:#172633;
 border:1px solid #526579;border-radius:14px;padding:20px
}
#setupBox h2{margin-top:0;color:#facc15}
#setupBox input{width:100%;margin:6px 0 12px}
#setupBox button{width:100%;margin-top:8px}
#eventLog{max-height:180px;overflow:auto;font-size:12px}
.logEntry{padding:6px 0;border-bottom:1px solid #34495e}
footer{text-align:center;padding:15px;color:#8295a7;font-size:11px}
@media(max-width:850px){
 .layout{grid-template-columns:1fr}
 #mapWrap{min-height:350px}
 #worldMap{min-height:350px}
}
</style>
</head>
<body>

<header>
 <h1>🌍 НОВА ЕПОХА</h1>
 <div>
  <button id="pauseBtn">⏸ Пауза</button>
  <button id="saveBtn">💾 Зберегти</button>
 </div>
</header>

<div class="layout">
 <main>
  <div class="panel">
   <div class="stats">
    <div class="stat"><small>Дата</small><strong id="date">2016 рік</strong></div>
    <div class="stat"><small>Казна</small><strong id="money">0 ₴</strong></div>
    <div class="stat"><small>Населення</small><strong id="population">0</strong></div>
    <div class="stat"><small>Щастя</small><strong id="happiness">0%</strong></div>
    <div class="stat"><small>Міста</small><strong id="cityCount">0</strong></div>
    <div class="stat"><small>Села</small><strong id="villageCount">0</strong></div>
   </div>
  </div>

  <div id="mapWrap">
   <svg id="worldMap" viewBox="0 0 900 570"
        preserveAspectRatio="xMidYMid meet"
        xmlns="http://www.w3.org/2000/svg">
    <defs>
     <pattern id="waterPattern" width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M0 12 Q6 7 12 12 T24 12" fill="none"
       stroke="#28576b" stroke-width="1" opacity=".5"/>
     </pattern>
    </defs>
    <rect width="900" height="570" fill="#1c4656"/>
    <rect width="900" height="570" fill="url(#waterPattern)"/>
    <g id="territories"></g>
    <g id="rivers"></g>
    <g id="roads"></g>
    <g id="mapObjects"></g>
    <g id="mapLabels"></g>
   </svg>
   <div id="mapHint">🗺️ Вигаданий світ. Обери територію для заснування держави</div>
  </div>

  <div class="panel">
   <h3 id="countryTitle">Твоя держава ще не створена</h3>
   <p id="capitalTitle" class="muted">Обери територію на карті</p>
   <p id="selectedInfo">Тут з'являтиметься інформація про вибрану територію.</p>
  </div>

  <div class="panel">
   <div class="tabs">
    <button data-tab="buildings">🏗 Будівлі</button>
    <button data-tab="economy">💰 Економіка</button>
    <button data-tab="people">👥 Населення</button>
    <button data-tab="trade">📦 Експорт</button>
    <button data-tab="politics">🏛 Політика</button>
    <button data-tab="countries">🌐 Країни</button>
    <button data-tab="wars">⚔️ Війни</button>
   </div>

   <section id="buildings" class="tabContent active">
    <h2>Будівництво</h2>
    <div id="buildList">Спочатку заснуй державу.</div>
   </section>

   <section id="economy" class="tabContent">
    <h2>Економіка</h2>
    <div id="economyContent"></div>
   </section>

   <section id="people" class="tabContent">
    <h2>Населення</h2>
    <div id="peopleContent"></div>
   </section>

   <section id="trade" class="tabContent">
    <h2>Експорт товарів</h2>
    <div id="tradeContent"></div>
   </section>

   <section id="politics" class="tabContent">
    <h2>Політика та вибори</h2>
    <div id="politicsContent"></div>
   </section>

   <section id="countries" class="tabContent">
    <h2>Інші держави</h2>
    <div id="countriesContent"></div>
   </section>

   <section id="wars" class="tabContent">
    <h2>Війни та кордони</h2>
    <div id="warsContent"></div>
   </section>
  </div>
 </main>

 <aside>
  <div class="panel">
   <h3>📊 Ресурси</h3>
   <div id="resources">Держава ще не створена.</div>
  </div>
  <div class="panel">
   <h3>🏙 Розвиток держави</h3>
   <div id="development">Після заснування тут з'явиться статистика.</div>
  </div>
  <div class="panel">
   <h3>📜 Події</h3>
   <div id="eventLog">Історія подій поки порожня.</div>
  </div>
  <div class="panel">
   <h3>⏩ Швидкість часу</h3>
   <button id="speed1">1×</button>
   <button id="speed2">2×</button>
   <button id="speed4">4×</button>
  </div>
 </aside>
</div>

<div id="setup">
 <div id="setupBox">
  <h2>🌍 Створи свою державу</h2>
  <p>Обери назву держави та назву столиці. Потім натисни на територію на карті.</p>
  <label>Назва держави</label>
  <input id="countryName" maxlength="24" placeholder="Наприклад, Арденія">
  <label>Назва столиці</label>
  <input id="capitalName" maxlength="24" placeholder="Наприклад, Новоград">
  <p id="chosenPlace" class="muted">Територію ще не обрано.</p>
  <button id="foundBtn" disabled>🏛 Заснувати державу</button>
 </div>
</div>

<script>
// ===== ЧАСТИНА 2. СВІТ І КРАЇНИ =====

const territories = [
 {id:0,name:"Арденія",color:"#3478a8",points:"80,100 220,65 290,140 245,245 100,250 45,170"},
 {id:1,name:"Весторія",color:"#8a6bb5",points:"290,140 420,70 510,130 475,245 350,275 245,245"},
 {id:2,name:"Нордвік",color:"#4d9b78",points:"510,130 650,65 790,110 850,210 720,265 590,245 475,245"},
 {id:3,name:"Соларія",color:"#b58a48",points:"100,250 245,245 350,275 330,400 210,470 75,400"},
 {id:4,name:"Дравен",color:"#a85c65",points:"350,275 475,245 590,245 620,390 510,480 330,400"},
 {id:5,name:"Естмарк",color:"#648a9f",points:"590,245 720,265 850,210 870,380 760,470 620,390"},
 {id:6,name:"Кальдор",color:"#8d9b4e",points:"75,400 210,470 330,400 510,480 460,550 180,550 40,490"},
 {id:7,name:"Равенія",color:"#a66e45",points:"510,480 620,390 760,470 870,380 850,520 700,550 460,550"}
];

const botCountries = territories.map((t,i)=>({
 id:t.id,
 name:t.name,
 color:t.color,
 money:800000+Math.floor(Math.random()*500000),
 population:300000+Math.floor(Math.random()*1200000),
 happiness:60+Math.floor(Math.random()*30),
 army:5000+Math.floor(Math.random()*15000),
 technology:1+Math.floor(Math.random()*4),
 owner:"bot",
 capital:["Астер","Велград","Нордхейм","Солем","Драгор","Естбург","Кальден","Равенг"][i],
 strength:50+Math.floor(Math.random()*50),
 relation:Math.floor(Math.random()*101)-50,
 atWar:false
}));

const mapState = {
 selected:null,
 borders:{},
 occupied:{}
};

let game = {
 started:false,
 paused:false,
 year:2016,
 month:1,
 day:1,
 speed:1,
 country:null,
 capital:null,
 territory:null,
 money:0,
 population:0,
 happiness:75,
 food:500,
 wood:400,
 stone:300,
 iron:150,
 oil:0,
 gas:0,
 electricity:0,
 cities:1,
 villages:2,
 buildings:[],
 construction:[],
 wars:[],
 trade:[],
 history:[],
 roads:[],
 businesses:[],
 taxRate:10,
 electionYear:2020,
 electionSupport:60
};

let selectedPlace = null;
let gameTimer = null;

// ===== МАЛЮЄМО КРАЇНИ =====

function drawWorld(){
 const territoryLayer=document.getElementById("territories");
 const riverLayer=document.getElementById("rivers");
 const labelLayer=document.getElementById("mapLabels");

 territoryLayer.innerHTML="";
 riverLayer.innerHTML="";
 labelLayer.innerHTML="";

 territories.forEach(t=>{
  const country=botCountries.find(c=>c.id===t.id);
  const path=document.createElementNS("http://www.w3.org/2000/svg","polygon");
  path.setAttribute("points",t.points);
  path.setAttribute("fill",country.color);
  path.setAttribute("stroke","#e2e8f0");
  path.setAttribute("stroke-width","2");
  path.setAttribute("class","territory");
  path.style.cursor="pointer";
  path.dataset.id=t.id;

  if(mapState.selected===t.id){
   path.setAttribute("stroke","#facc15");
   path.setAttribute("stroke-width","5");
  }

  path.addEventListener("click",()=>selectTerritory(t.id));
  territoryLayer.appendChild(path);

  const center=territoryCenter(t.points);
  const label=document.createElementNS("http://www.w3.org/2000/svg","text");
  label.setAttribute("x",center.x);
  label.setAttribute("y",center.y);
  label.setAttribute("text-anchor","middle");
  label.setAttribute("class","map-label");
  label.textContent=country.name;
  labelLayer.appendChild(label);

  const city=document.createElementNS("http://www.w3.org/2000/svg","circle");
  city.setAttribute("cx",center.x);
  city.setAttribute("cy",center.y+18);
  city.setAttribute("r","5");
  city.setAttribute("fill","#facc15");
  city.setAttribute("class","map-city");
  labelLayer.appendChild(city);
 });

 drawRivers();
 drawMapObjects();
}

function territoryCenter(points){
 const coords=points.split(" ").map(p=>p.split(",").map(Number));
 const x=coords.reduce((s,p)=>s+p[0],0)/coords.length;
 const y=coords.reduce((s,p)=>s+p[1],0)/coords.length;
 return {x,y};
}

// ===== РІЧКИ =====

function drawRivers(){
 const layer=document.getElementById("rivers");
 const riverPaths=[
  "M40 180 Q170 210 260 180 T480 220 T850 170",
  "M160 70 Q200 180 300 260 T400 500",
  "M700 70 Q650 170 690 260 T790 500",
  "M430 60 Q450 160 420 260 T480 500"
 ];

 riverPaths.forEach(d=>{
  const p=document.createElementNS("http://www.w3.org/2000/svg","path");
  p.setAttribute("d",d);
  p.setAttribute("class","map-river");
  layer.appendChild(p);
 });
}

// ===== РЕСУРСИ НА КАРТІ =====

function drawMapObjects(){
 const layer=document.getElementById("mapObjects");
 layer.innerHTML="";

 const objects=[
  {x:150,y:150,icon:"🌲",name:"Ліси"},
  {x:390,y:160,icon:"⛏️",name:"Залізо"},
  {x:680,y:150,icon:"🛢️",name:"Нафта"},
  {x:160,y:350,icon:"🌾",name:"Родючі землі"},
  {x:440,y:350,icon:"🪨",name:"Камінь"},
  {x:720,y:350,icon:"🔥",name:"Газ"},
  {x:330,y:500,icon:"🌲",name:"Ліси"},
  {x:650,y:500,icon:"⛏️",name:"Мідь"}
 ];

 objects.forEach(o=>{
  const text=document.createElementNS("http://www.w3.org/2000/svg","text");
  text.setAttribute("x",o.x);
  text.setAttribute("y",o.y);
  text.setAttribute("font-size","20");
  text.textContent=o.icon;
  text.style.cursor="help";
  text.addEventListener("click",()=>showEvent("Ресурс: "+o.name));
  layer.appendChild(text);
 });
}

// ===== ВИБІР ТЕРИТОРІЇ =====

function selectTerritory(id){
 if(game.started){
  const t=territories.find(x=>x.id===id);
  const owner=botCountries.find(x=>x.id===id);
  document.getElementById("selectedInfo").textContent=
   owner.name+" — населення: "+owner.population.toLocaleString("uk-UA")+
   ", казна: "+owner.money.toLocaleString("uk-UA")+" ₴";
  return;
 }

 selectedPlace=id;
 mapState.selected=id;
 const t=territories.find(x=>x.id===id);

 document.getElementById("chosenPlace").textContent=
  "Обрана територія: "+t.name;
 document.getElementById("foundBtn").disabled=false;

 drawWorld();
}

// ===== СТВОРЕННЯ ДЕРЖАВИ =====

document.getElementById("foundBtn").addEventListener("click",()=>{
 if(selectedPlace===null){
  alert("Спочатку обери територію на карті!");
  return;
 }

 const countryName=document.getElementById("countryName").value.trim();
 const capitalName=document.getElementById("capitalName").value.trim();

 if(!countryName||!capitalName){
  alert("Введи назву держави та столиці!");
  return;
 }

 if(botCountries.some(c=>c.id===selectedPlace)){
  const territory=territories.find(t=>t.id===selectedPlace);
  const bot=botCountries.find(c=>c.id===selectedPlace);

  game.started=true;
  game.country=countryName;
  game.capital=capitalName;
  game.territory=selectedPlace;
  game.money=1000000;
  game.population=100000;
  game.happiness=75;
  game.cities=1;
  game.villages=2;

  bot.name=countryName;
  bot.capital=capitalName;
  bot.owner="player";
  bot.money=game.money;
  bot.population=game.population;
  bot.happiness=game.happiness;

  document.getElementById("setup").style.display="none";
  document.getElementById("countryTitle").textContent="🏛 "+countryName;
  document.getElementById("capitalTitle").textContent="Столиця: "+capitalName;
  document.getElementById("selectedInfo").textContent=
   "Твоя держава заснована у 2016 році.";
  showEvent("Засновано державу "+countryName+" зі столицею "+capitalName);
  renderAll();
 }
});

// ===== ПЕРЕМИКАННЯ ВКЛАДОК =====

document.querySelectorAll("[data-tab]").forEach(button=>{
 button.addEventListener("click",()=>{
  document.querySelectorAll(".tabContent").forEach(tab=>{
   tab.classList.remove("active");
  });
  document.querySelectorAll("[data-tab]").forEach(b=>{
   b.style.background="#245b83";
  });
  document.getElementById(button.dataset.tab).classList.add("active");
  button.style.background="#a16207";
 });
});

// ===== ПОВІДОМЛЕННЯ =====

function showEvent(message){
 const log=document.getElementById("eventLog");
 if(log.textContent==="Історія подій поки порожня.")log.textContent="";
 const entry=document.createElement("div");
 entry.className="logEntry";
 entry.textContent="["+game.year+"] "+message;
 log.prepend(entry);
 while(log.children.length>40){
  log.removeChild(log.lastChild);
 }
}

// ===== ПОЧАТКОВЕ ВІДОБРАЖЕННЯ =====

drawWorld();
// ===== ЧАСТИНА 3. АВТОМАТИЧНИЙ РОЗВИТОК =====

const buildingTypes = [
 {id:"factory",name:"Промисловий завод",icon:"🏭",cost:120000,time:8,resource:"iron",production:35},
 {id:"farm",name:"Агрокомплекс",icon:"🌾",cost:65000,time:5,resource:"food",production:100},
 {id:"sawmill",name:"Лісопереробний завод",icon:"🪵",cost:75000,time:6,resource:"wood",production:65},
 {id:"quarry",name:"Кам'яний кар'єр",icon:"🪨",cost:90000,time:7,resource:"stone",production:55},
 {id:"ironmine",name:"Залізна шахта",icon:"⛏️",cost:150000,time:10,resource:"iron",production:80},
 {id:"coppermine",name:"Мідна шахта",icon:"🔶",cost:130000,time:9,resource:"copper",production:50},
 {id:"oilwell",name:"Нафтова свердловина",icon:"🛢️",cost:220000,time:12,resource:"oil",production:65},
 {id:"gaswell",name:"Газова свердловина",icon:"🔥",cost:190000,time:11,resource:"gas",production:70},
 {id:"power",name:"Електростанція",icon:"⚡",cost:180000,time:10,resource:"electricity",production:120},
 {id:"chemical",name:"Хімічний завод",icon:"🧪",cost:210000,time:12,resource:"chemicals",production:40},
 {id:"port",name:"Морський порт",icon:"⚓",cost:250000,time:14,resource:"trade",production:1},
 {id:"railway",name:"Залізничний вузол",icon:"🚆",cost:140000,time:9,resource:"transport",production:1},
 {id:"electronics",name:"Електронний завод",icon:"💻",cost:300000,time:16,resource:"electronics",production:25},
 {id:"carfactory",name:"Автомобільний завод",icon:"🚗",cost:280000,time:15,resource:"cars",production:20}
];

const budgetTypes = [
 {id:"education",name:"Освіта",value:15},
 {id:"medicine",name:"Медицина",value:15},
 {id:"infrastructure",name:"Інфраструктура",value:20},
 {id:"industry",name:"Промисловість",value:25},
 {id:"defense",name:"Оборона",value:15},
 {id:"science",name:"Наука",value:10}
];

Object.assign(game,{
 copper:0,
 chemicals:0,
 electronics:0,
 cars:0,
 transport:0,
 tradeCapacity:0,
 budgets:{
  education:15,
  medicine:15,
  infrastructure:20,
  industry:25,
  defense:15,
  science:10
 },
 construction:[],
 buildings:game.buildings||[],
 citiesData:[],
 totalTaxes:0,
 totalProduction:0,
 unemployment:8,
 educationLevel:40,
 healthLevel:60,
 infrastructureLevel:35,
 technologyLevel:1
});

// ===== СТВОРЕННЯ МІСТ =====

function createCity(name,population,type){
 return {
  name:name,
  population:population,
  type:type,
  housing:50,
  happiness:70,
  jobs:Math.floor(population*0.45),
  buildings:0,
  level:1
 };
}

function initializeCities(){
 if(game.citiesData.length)return;

 game.citiesData=[
  createCity(game.capital,game.population,"Столиця"),
  createCity("Верхньоград",35000,"Місто"),
  createCity("Зелене Поле",12000,"Місто"),
  createCity("Мала Долина",3500,"Село"),
  createCity("Річкове",2200,"Село")
 ];

 game.cities=game.citiesData.length;
 game.villages=2;
}

// ===== БУДІВНИЦТВО ПРОМИСЛОВОСТІ =====

function startConstruction(id){
 if(!game.started)return;

 const type=buildingTypes.find(b=>b.id===id);
 if(!type)return;

 if(game.money<type.cost){
  showEvent("Недостатньо коштів для будівництва "+type.name);
  return;
 }

 game.money-=type.cost;

 game.construction.push({
  id:type.id,
  name:type.name,
  remaining:type.time,
  total:type.time
 });

 showEvent("Розпочато будівництво: "+type.name);
 renderAll();
}

function processConstruction(){
 for(let i=game.construction.length-1;i>=0;i--){
  let job=game.construction[i];
  job.remaining--;

  if(job.remaining<=0){
   const type=buildingTypes.find(b=>b.id===job.id);

   if(type){
    game.buildings.push({
     id:type.id,
     name:type.name,
     production:type.production,
     resource:type.resource
    });

    showEvent("Завершено будівництво: "+type.name);
   }

   game.construction.splice(i,1);
  }
 }
}

// ===== АВТОМАТИЧНЕ ЗРОСТАННЯ МІСТ =====

function developCities(){
 if(!game.started)return;

 game.citiesData.forEach(city=>{
  let growth=city.population*0.00008;
  city.population+=Math.floor(growth);

  city.housing+=0.02;
  city.jobs=Math.floor(city.population*0.45);

  let educationBonus=game.budgets.education/100;
  let medicineBonus=game.budgets.medicine/100;

  city.happiness+=educationBonus*0.01;
  city.happiness+=medicineBonus*0.01;
  city.happiness=Math.min(100,Math.max(0,city.happiness));

  // Місто автоматично розбудовує житло та інфраструктуру
  if(city.housing>=100){
   city.housing=0;
   city.buildings++;
   showEvent(city.name+" автоматично розбудувало новий житловий квартал.");
  }

  // Село може поступово стати містом
  if(city.type==="Село"&&city.population>=10000){
   city.type="Місто";
   game.villages=Math.max(0,game.villages-1);
   game.cities++;
   showEvent(city.name+" отримало статус міста!");
  }
 });

 game.population=game.citiesData.reduce((sum,c)=>sum+c.population,0);
 game.cities=game.citiesData.filter(c=>c.type!=="Село").length;
 game.villages=game.citiesData.filter(c=>c.type==="Село").length;
}

// ===== ВИРОБНИЦТВО РЕСУРСІВ =====

function produceResources(){
 if(!game.started)return;

 game.buildings.forEach(building=>{
  if(building.resource&&typeof game[building.resource]==="number"){
   game[building.resource]+=building.production;
  }
 });

 game.totalProduction=game.buildings.length;
}

// ===== ДЕРЖАВНИЙ БЮДЖЕТ =====

function setBudget(id,value){
 if(!game.started)return;

 value=Math.max(0,Math.min(60,Number(value)));
 game.budgets[id]=value;

 let total=Object.values(game.budgets).reduce((a,b)=>a+b,0);

 if(total>100){
  game.budgets[id]-=total-100;
 }

 renderAll();
}

function getBudgetTotal(){
 return Object.values(game.budgets).reduce((a,b)=>a+b,0);
}

function calculateBudget(){
 const total=getBudgetTotal();

 let industryIncome=game.buildings.length*1500;
 let taxIncome=game.population*game.taxRate*0.015;

 game.totalTaxes=Math.floor(taxIncome);
 game.money+=game.totalTaxes+industryIncome;

 let spending=game.money*0.0005;
 game.money-=spending;

 if(total<100){
  game.happiness-=0.03;
 }

 game.happiness=Math.max(0,Math.min(100,game.happiness));
}

