(() => {
  const svg = document.getElementById("worldMap");
  const territoryLayer = document.getElementById("territories");
  const resourceLayer = document.getElementById("resources");
  const labelLayer = document.getElementById("mapLabels");

  if (!svg || !territoryLayer || !resourceLayer || !labelLayer) {
    console.error("Не знайдено шари карти для частини 2");
    return;
  }

  const viewBox = svg.viewBox.baseVal;
  const W = viewBox.width || 1000;
  const H = viewBox.height || 700;

  const worldStates = [
    {
      name: "Королівство Вестмар",
      color: "#d9a441",
      points: [
        [0.08,0.25],[0.23,0.19],[0.34,0.29],
        [0.31,0.48],[0.21,0.57],[0.10,0.46]
      ],
      capital: "Вестград",
