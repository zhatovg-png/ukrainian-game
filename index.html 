    {
      name: "Гірська держава Арден",
      color: "#a77ab8",
      points: [
        [0.21,0.57],[0.31,0.48],[0.53,0.56],
        [0.51,0.77],[0.35,0.86],[0.19,0.76]
      ],
      capital: "Арденбург",
      population: 14700
    }
  ];

  function makeSvgElement(tag, attributes) {
    const element = document.createElementNS(
      "http://www.w3.org/2000/svg",
      tag
    );

    Object.entries(attributes).forEach(([key, value]) => {
      element.setAttribute(key, value);
    });

    return element;
  }

  worldStates.forEach((state, index) => {
    const points = state.points.map(([x, y]) => {
      return `${x * W},${y * H}`;
    }).join(" ");

    const territory = makeSvgElement("polygon", {
      points,
      fill: state.color,
      "fill-opacity": "0.17",
      stroke: state.color,
      "stroke-width": "3",
      "stroke-opacity": "0.9",
      "stroke-linejoin": "round",
      "class": "country-territory"
    });

    territoryLayer.appendChild(territory);

    const centerX = state.points.reduce(
      (sum, point) => sum + point[0], 0
    ) / state.points.length * W;

    const centerY = state.points.reduce(
      (sum, point) => sum + point[1], 0
    ) / state.points.length * H;

    const stateLabel = makeSvgElement("text", {
      x: centerX,
      y: centerY,
      "text-anchor": "middle",
      fill: "#ffffff",
      "font-size": Math.max(13, W * 0.017),
      "font-weight": "bold",
      "paint-order": "stroke",
      stroke: "#17212b",
      "stroke-width": "4",
      "stroke-linejoin": "round",
      "class": "country-label"
    });

    stateLabel.textContent = state.name;
    labelLayer.appendChild(stateLabel);

    const capital = makeSvgElement("text", {
      x: centerX,
      y: centerY + 20,
      "text-anchor": "middle",
      fill: "#fff3bd",
      "font-size": Math.max(10, W * 0.012),
      "paint-order": "stroke",
      stroke: "#17212b",
      "stroke-width": "3"
    });

    capital.textContent = "★ " + state.capital;
    labelLayer.appendChild(capital);

    state.id = index + 1;
  });

  const worldResources = [
    {name:"Залізо",x:0.15,y:0.35,color:"#aeb8c2",symbol:"◆"},
    {name:"Золото",x:0.27,y:0.29,color:"#ffd34f",symbol:"◆"},
    {name:"Вугілля",x:0.42,y:0.22,color:"#424a55",symbol:"◆"},
    {name:"Ліс",x:0.47,y:0.42,color:"#61b86b",symbol:"♣"},
    {name:"Мідь",x:0.68,y:0.48,color:"#d88b55",symbol:"◆"},
    {name:"Залізо",x:0.77,y:0.55,color:"#aeb8c2",symbol:"◆"},
    {name:"Камінь",x:0.40,y:0.70,color:"#c0b9ad",symbol:"◆"},
    {name:"Вугілля",x:0.58,y:0.73,color:"#424a55",symbol:"◆"},
    {name:"Ліс",x:0.82,y:0.72,color:"#61b86b",symbol:"♣"},
    {name:"Золото",x:0.29,y:0.78,color:"#ffd34f",symbol:"◆"}
  ];

  worldResources.forEach(resource => {
    const x = resource.x * W;
    const y = resource.y * H;

    const group = makeSvgElement("g", {
      transform: `translate(${x} ${y})`,
      class: "map-resource"
    });

    const circle = makeSvgElement("circle", {
      cx: 0,
      cy: 0,
      r: Math.max(10, W * 0.012),
      fill: "#152331",
      stroke: resource.color,
      "stroke-width": "2"
    });

    const symbol = makeSvgElement("text", {
      x: 0,
      y: 5,
      "text-anchor": "middle",
      fill: resource.color,
      "font-size": Math.max(12, W * 0.015),
      "font-weight": "bold"
    });

    symbol.textContent = resource.symbol;

    const title = makeSvgElement("title", {});
    title.textContent = resource.name;

    group.appendChild(circle);
    group.appendChild(symbol);
    group.appendChild(title);
    resourceLayer.appendChild(group);
  });

  const style = document.createElement("style");
  style.textContent = `
    .country-territory {
      transition: fill-opacity .3s ease;
      pointer-events: none;
    }

    .country-territory:hover {
      fill-opacity: .28;
    }

    .country-label {
      pointer-events: none;
      user-select: none;
    }

    .map-resource {
      cursor: help;
      pointer-events: auto;
    }

    .map-resource circle {
      filter: drop-shadow(0 1px 4px #0009);
    }
  `;
  document.head.appendChild(style);

  window.worldStates = worldStates;
  window.worldResources = worldResources;

  console.log("Частина 2 завантажена: держави та ресурси");
})();

 // ================================
 // ЧАСТИНА 3 — СТВОРЕННЯ ДЕРЖАВИ
 // ================================

(() => {
  const map = document.getElementById("worldMap");
  const territories = document.getElementById("territories");
  const settlements = document.getElementById("settlements");
  const labels = document.getElementById("mapLabels");
  const foundButton = document.getElementById("foundBtn");

  if (!map || !territories || !settlements || !labels || !foundButton) {
    console.error("Помилка: не знайдено елементи створення держави");
    return;
  }

  const countryInput =
    document.getElementById("countryName") ||
    document.querySelector('input[placeholder*="держав"]') ||
    document.querySelector('input[placeholder*="країн"]');

  const capitalInput =
    document.getElementById("capitalName") ||
    document.querySelector('input[placeholder*="столи"]');

  const ns = "http://www.w3.org/2000/svg";
  const view = map.viewBox.baseVal;
  const mapWidth = view.width || 1000;
  const mapHeight = view.height || 700;

  function svgElement(tag, attrs) {
    const el = document.createElementNS(ns, tag);
    Object.entries(attrs).forEach(([key, value]) => {
      el.setAttribute(key, value);
    });
    return el;
  }

  function getSelectedPoint() {
    if (!window.selectedLocation && typeof selectedLocation === "undefined") {
      return null;
    }

    const point = typeof selectedLocation !== "undefined"
      ? selectedLocation
      : window.selectedLocation;

    if (!point) return null;

    let x = Number(point.x ?? point.clientX);
    let y = Number(point.y ?? point.clientY);

    if (!Number.isFinite(x) || !Number.isFinite(y)) return null;

    if (x <= 1 && y <= 1) {
      x *= mapWidth;
      y *= mapHeight;
    }

    return {
      x: Math.max(20, Math.min(mapWidth - 20, x)),
      y: Math.max(20, Math.min(mapHeight - 20, y))
    };
  }

  function createCountryShape(x, y, color) {
    const points = [
      [-100,-55],[-55,-100],[15,-95],[90,-60],
      [110,0],[75,70],[10,100],[-75,75],[-110,10]
    ];

    const polygonPoints = points.map(([dx, dy]) => {
      return `${x + dx},${y + dy}`;
    }).join(" ");

    const polygon = svgElement("polygon", {
      points: polygonPoints,
      fill: color,
      "fill-opacity": "0.28",
      stroke: color,
      "stroke-width": "4",
      "stroke-linejoin": "round",
      class: "player-country-border"
    });

    territories.appendChild(polygon);
  }

  function createCapital(x, y, capitalName) {
    const marker = svgElement("g", {
      transform: `translate(${x} ${y})`,
      class: "player-capital"
    });

    marker.appendChild(svgElement("circle", {
      cx: 0, cy: 0, r: 13,
      fill: "#f5c542",
      stroke: "#fff",
      "stroke-width": "3"
    }));

    marker.appendChild(svgElement("circle", {
      cx: 0, cy: 0, r: 4,
      fill: "#513a12"
    }));

    settlements.appendChild(marker);

    const label = svgElement("text", {
      x: x + 17,
      y: y - 15,
      fill: "#fff2b2",
      "font-size": "15",
      "font-weight": "bold",
      "paint-order": "stroke",
      stroke: "#18232d",
      "stroke-width": "4"
    });

    label.textContent = "★ " + capitalName;
    labels.appendChild(label);
  }

  function showMessage(message) {
    let box = document.getElementById("foundingMessage");

    if (!box) {
      box = document.createElement("div");
      box.id = "foundingMessage";
      box.style.cssText =
        "position:fixed;bottom:18px;left:50%;transform:translateX(-50%);" +
        "z-index:9999;background:#1d2d3c;color:white;padding:12px 18px;" +
        "border:1px solid #71869a;border-radius:12px;font-weight:bold;" +
        "max-width:90%;text-align:center";
      document.body.appendChild(box);
    }

    box.textContent = message;
    box.style.display = "block";
  }

  foundButton.addEventListener("click", () => {
    if (window.playerCountry) {
      showMessage("Ти вже заснував свою державу!");
      return;
    }

    const point = getSelectedPoint();

    if (!point) {
      showMessage("Спочатку постав мітку на карті!");
      return;
    }

    const countryName = countryInput
      ? countryInput.value.trim()
      : "";

    const capitalName = capitalInput
      ? capitalInput.value.trim()
      : "";

    if (!countryName || !capitalName) {
      showMessage("Введи назву держави та столиці!");
      return;
    }

    const colors = [
      "#e3a342", "#4b9ed0", "#70ad68",
      "#b17ac2", "#d46e69", "#55b7a7"
    ];

    const color = colors[Math.floor(Math.random() * colors.length)];

    createCountryShape(point.x, point.y, color);
    createCapital(point.x, point.y, capitalName);

    window.playerCountry = {
      name: countryName,
      capital: capitalName,
      x: point.x,
      y: point.y,
      color: color,
      population: 1000,
      treasury: 50000,
      year: 2016,
      cities: [capitalName],
      founded: true
    };

    window.gameStarted = true;

    const modal = document.getElementById("setupModal");
    if (modal) modal.style.display = "none";

    const countryDisplay = document.getElementById("countryDisplay");
    if (countryDisplay) {
      countryDisplay.textContent = countryName;
    }

    showMessage("Державу «" + countryName + "» засновано!");

    foundButton.disabled = true;

    console.log("Створено державу:", window.playerCountry);
  });

  console.log("Частина 3 завантажена");
})();

// ===================================
// ЧАСТИНА 4 — РОЗВИТОК МІСТ ТА ЕКОНОМІКА
// ===================================

(() => {
  const map = document.getElementById("worldMap");
  const settlements = document.getElementById("settlements");
  const roads = document.getElementById("roads");
  const labels = document.getElementById("mapLabels");

  if (!map || !settlements || !roads || !labels) {
    console.error("Не знайдено шари для розвитку міст");
    return;
  }

  const ns = "http://www.w3.org/2000/svg";
  const vb = map.viewBox.baseVal;
  const W = vb.width || 1000;
  const H = vb.height || 700;

  const cityStyle = document.createElement("style");
  cityStyle.textContent = `
    .city-building {
      stroke: #302a23;
      stroke-width: 1.5;
    }
    .city-smoke {
      fill: #e9edf0;
      opacity: .35;
      animation: citySmoke 3s ease-in-out infinite;
    }
    .city-pulse {
      fill: none;
      stroke: #f5d17b;
      stroke-width: 2;
      animation: cityPulse 2.5s ease-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
    @keyframes citySmoke {
      0%,100% { opacity: .12; transform: translateY(0); }
      50% { opacity: .5; transform: translateY(-7px); }
    }
    @keyframes cityPulse {
      0% { opacity: .8; transform: scale(.7); }
      100% { opacity: 0; transform: scale(2.2); }
    }
  `;
  document.head.appendChild(cityStyle);

  function el(tag, attrs) {
    const node = document.createElementNS(ns, tag);
    Object.entries(attrs).forEach(([key, value]) => {
      node.setAttribute(key, value);
    });
    return node;
  }

  function getCountry() {
    return window.playerCountry || null;
  }

  function makeCity(x, y, name, size) {
    const group = el("g", {
      transform: `translate(${x} ${y})`,
      class: "developing-city"
    });

    group.appendChild(el("circle", {
      cx: 0, cy: 0, r: 19 + size * 2,
      class: "city-pulse"
    }));

    const houseCount = Math.min(12, 3 + size * 2);

    for (let i = 0; i < houseCount; i++) {
      const angle = i * 2.4;
      const radius = 8 + (i % 3) * 8;
      const hx = Math.cos(angle) * radius;
      const hy = Math.sin(angle) * radius;

      group.appendChild(el("rect", {
        x: hx - 4,
        y: hy - 4,
        width: 9,
        height: 8,
        rx: 1,
        fill: ["#bd8755", "#d5b16e", "#a96f51"][i % 3],
        class: "city-building"
      }));

      group.appendChild(el("polygon", {
        points: `${hx-5},${hy-4} ${hx},${hy-10} ${hx+5},${hy-4}`,
        fill: "#713f32",
        class: "city-building"
      }));
    }

    group.appendChild(el("circle", {
      cx: 5, cy: -15, r: 2,
      class: "city-smoke"
    }));

    group.appendChild(el("circle", {
      cx: 8, cy: -20, r: 3,
      class: "city-smoke"
    }));

    settlements.appendChild(group);

    const label = el("text", {
      x: x,
      y: y + 37,
      "text-anchor": "middle",
      fill: "#ffffff",
      "font-size": "13",
      "font-weight": "bold",
      "paint-order": "stroke",
      stroke: "#17212b",
      "stroke-width": "4"
    });

    label.textContent = name;
    labels.appendChild(label);

    return group;
  }

  function connectCities(a, b) {
    const line = el("path", {
      d: `M ${a.x} ${a.y} L ${b.x} ${b.y}`,
      fill: "none",
      stroke: "#c4a77b",
      "stroke-width": "4",
      "stroke-linecap": "round",
      "stroke-dasharray": "2 3",
      opacity: ".9"
    });

    roads.appendChild(line);
  }

  const initialCities = [
    {name: "Берегове", x: .17, y: .43},
    {name: "Лісоград", x: .42, y: .51},
    {name: "Златопіль", x: .73, y: .37}
  ];

  window.cityWorld = window.cityWorld || [];

  initialCities.forEach((city, index) => {
    const item = {
      name: city.name,
      x: city.x * W,
      y: city.y * H,
      population: 350 + index * 120,
      level: 1,
      houses: 3,
      isPlayerCity: false
    };

    window.cityWorld.push(item);
    makeCity(item.x, item.y, item.name, item.level);
  });

  function initializePlayerEconomy() {
    const country = getCountry();
    if (!country || country.economyInitialized) return;

    country.food = 500;
    country.wood = 300;
    country.stone = 200;
    country.iron = 50;
    country.population = country.population || 1000;
    country.treasury = country.treasury || 50000;
    country.buildings = {
      houses: 5,
      farms: 2,
      sawmills: 1,
      quarries: 1
    };
    country.economyInitialized = true;

    window.cityWorld.push({
      name: country.capital,
      x: country.x,
      y: country.y,
      population: country.population,
      level: 2,
      houses: 5,
      isPlayerCity: true
    });

    makeCity(country.x, country.y, country.capital, 2);
  }

  function developPlayerCountry() {
    const country = getCountry();
    if (!country || !country.economyInitialized) return;

    const buildings = country.buildings;

    country.food += buildings.farms * 8;
    country.wood += buildings.sawmills * 5;
    country.stone += buildings.quarries * 4;
    country.population += Math.max(1, Math.floor(
      country.population * 0.002
    ));

    country.treasury += Math.floor(country.population * 0.01);

    if (country.food > country.population * 0.1) {
      country.population += Math.floor(country.population * 0.001);
    }
  }

  window.buildCityBuilding = function(type) {
    const country = getCountry();

    if (!country || !country.economyInitialized) {
      return "Спочатку заснуй державу!";
    }

    const prices = {
      houses: {wood: 30, stone: 10},
      farms: {wood: 40, stone: 10},
      sawmills: {wood: 50, stone: 20},
      quarries: {wood: 30, stone: 30}
    };

    const price = prices[type];

    if (!price) return "Невідомий тип будівлі";

    if (country.wood < price.wood || country.stone < price.stone) {
      return "Недостатньо ресурсів!";
    }

    country.wood -= price.wood;
    country.stone -= price.stone;
    country.buildings[type] += 1;

    return "Будівлю успішно зведено!";
  };

  window.addNewCity = function(name, x, y) {
    const country = getCountry();

    if (!country || !country.economyInitialized) {
      return "Спочатку заснуй державу!";
    }

    if (!name || !Number.isFinite(x) || !Number.isFinite(y)) {
      return "Перевір назву та координати міста";
    }

    const city = {
      name: name,
      x: Math.max(10, Math.min(W - 10, x)),
      y: Math.max(10, Math.min(H - 10, y)),
      population: 100,
      level: 1,
      houses: 2,
      isPlayerCity: true
    };

    const previous = window.cityWorld.find(c => c.isPlayerCity);

    window.cityWorld.push(city);
    makeCity(city.x, city.y, city.name, city.level);

    if (previous) connectCities(previous, city);

    country.cities.push(name);
    return "Нове місто засновано!";
  };

  function runCityDevelopment() {
    initializePlayerEconomy();
    developPlayerCountry();

    window.cityWorld.forEach(city => {
      city.population += Math.max(
        1,
        Math.floor(city.population * 0.001)
      );

      if (city.population > 1000 && city.level < 3) {
        city.level++;
        city.houses += 2;
        makeCity(city.x, city.y, city.name, city.level);
      }
    });
  }

  window.runCityDevelopment = runCityDevelopment;

  console.log("Частина 4 завантажена");
})();

// ===================================
// ЧАСТИНА 5 — ПОЛІТИКА, ТОРГІВЛЯ, ДИПЛОМАТІЯ
// ===================================

(() => {
  const country = () => window.playerCountry || null;

  window.worldDiplomacy = window.worldDiplomacy || {};
  window.worldTradeHistory = window.worldTradeHistory || [];
  window.worldEvents = window.worldEvents || [];

  function notifyWorld(message) {
    window.worldEvents.unshift({
      message,
      date: new Date().toLocaleString("uk-UA")
    });

    window.worldEvents = window.worldEvents.slice(0, 50);

    let panel = document.getElementById("worldEventPanel");

    if (!panel) {
      panel = document.createElement("div");
      panel.id = "worldEventPanel";
      panel.style.cssText =
        "position:fixed;right:12px;bottom:12px;z-index:9000;" +
        "width:min(340px,90vw);max-height:190px;overflow:auto;" +
        "background:#182838;color:#fff;border:1px solid #526a7e;" +
        "border-radius:12px;padding:10px;font:13px Arial";
      document.body.appendChild(panel);
    }

    panel.innerHTML = "<b>Останні події</b>";

    window.worldEvents.slice(0, 5).forEach(event => {
      const line = document.createElement("div");
      line.style.cssText = "padding:6px 0;border-bottom:1px solid #405365";
      line.textContent = event.message;
      panel.appendChild(line);
    });
  }

  function getOtherCountries() {
    return (window.worldStates || []).map(state => ({
      id: state.id,
      name: state.name,
      population: state.population,
      relations: window.worldDiplomacy[state.id] || 0
    }));
  }

  window.getDiplomacy = function() {
    return getOtherCountries();
  };

  window.changeDiplomacy = function(stateId, amount) {
    const state = (window.worldStates || []).find(
      item => item.id === Number(stateId)
    );

    if (!state) return "Державу не знайдено";

    const current = window.worldDiplomacy[state.id] || 0;
    const next = Math.max(-100, Math.min(100, current + amount));

    window.worldDiplomacy[state.id] = next;

    if (amount > 0) {
      notifyWorld("Відносини з державою «" + state.name + "» покращилися.");
    } else {
      notifyWorld("Відносини з державою «" + state.name + "» погіршилися.");
    }

    return "Новий рівень відносин: " + next;
  };

  window.createAlliance = function(stateId) {
    const state = (window.worldStates || []).find(
      item => item.id === Number(stateId)
    );

    if (!state) return "Державу не знайдено";

    if ((window.worldDiplomacy[state.id] || 0) < 30) {
      return "Спочатку покращи дипломатичні відносини до +30";
    }

    window.worldDiplomacy[state.id] = 100;
    notifyWorld("Укладено союз із державою «" + state.name + "»!");

    return "Союз укладено!";
  };

  window.tradeResources = function(resource, amount, direction) {
    const player = country();

    if (!player || !player.economyInitialized) {
      return "Спочатку заснуй державу!";
    }

    const allowed = ["food", "wood", "stone", "iron"];
    const quantity = Math.floor(Number(amount));

    if (!allowed.includes(resource)) {
      return "Невідомий ресурс";
    }

    if (!Number.isFinite(quantity) || quantity < 1 || quantity > 1000) {
      return "Кількість має бути від 1 до 1000";
    }

    const prices = {
      food: 3,
      wood: 7,
      stone: 8,
      iron: 15
    };

    const price = prices[resource];

    if (direction === "sell") {
      if (player[resource] < quantity) {
        return "Недостатньо ресурсу для продажу";
      }

      player[resource] -= quantity;
      player.treasury += quantity * price;
    } else if (direction === "buy") {
      const total = quantity * price;

      if (player.treasury < total) {
        return "Недостатньо грошей";
      }

      player.treasury -= total;
      player[resource] += quantity;
    } else {
      return "Невідомий напрямок торгівлі";
    }

    window.worldTradeHistory.unshift({
      resource,
      amount: quantity,
      direction,
      total: quantity * price
    });

    window.worldTradeHistory =
      window.worldTradeHistory.slice(0, 30);

    notifyWorld(
      (direction === "sell" ? "Продано " : "Куплено ") +
      quantity + " од. ресурсу: " + resource
    );

    return "Торгівлю завершено. Сума: " + quantity * price + " ₴";
  };

  window.setTaxRate = function(rate) {
    const player = country();

    if (!player || !player.economyInitialized) {
      return "Спочатку заснуй державу!";
    }

    const value = Number(rate);

    if (!Number.isFinite(value) || value < 0 || value > 30) {
      return "Податок має бути від 0 до 30%";
    }

    player.taxRate = value;

    notifyWorld("Податкову ставку встановлено на " + value + "%.");

    return "Нову ставку податку встановлено!";
  };

  window.collectTaxes = function() {
    const player = country();

    if (!player || !player.economyInitialized) {
      return "Спочатку заснуй державу!";
    }

    const rate = player.taxRate ?? 10;
    const income = Math.floor(
      player.population * rate * 0.08
    );

    player.treasury += income;

    notifyWorld("Казна отримала " + income + " ₴ податків.");

    return "До казни надійшло " + income + " ₴";
  };

  function developBotCountries() {
    (window.worldStates || []).forEach(state => {
      const growth = Math.max(
        10,
        Math.floor(state.population * 0.001)
      );

      state.population += growth;

      state.economy = state.economy || {
        treasury: 10000,
        industry: 1,
        development: 1
      };

      state.economy.treasury += Math.floor(growth * 2);

      if (Math.random() < 0.08) {
        state.economy.development++;
        notifyWorld(
          "Держава «" + state.name + "» розвиває економіку."
        );
      }
    });
  }

  window.developBotCountries = developBotCountries;

  window.getCountryStatistics = function() {
    const player = country();

    if (!player) return null;

    return {
      name: player.name,
      capital: player.capital,
      population: player.population,
      treasury: player.treasury,
      food: player.food,
      wood: player.wood,
      stone: player.stone,
      iron: player.iron,
      taxRate: player.taxRate ?? 10,
      cities: player.cities || []
    };
  };

  console.log("Частина 5 завантажена");
})();

