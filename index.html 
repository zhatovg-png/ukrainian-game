function createShop() {
    const city = getSelectedCity();

    if (!city) return;

    const shopName = prompt("Назва твого магазину:");

    if (!shopName || !shopName.trim()) return;

    const price = 5000;

    if (gameData.money < price) {
        alert("Недостатньо гривень!");
        return;
    }

    gameData.money -= price;

    gameData.shops.push({
        id: Date.now() + Math.random(),
        name: shopName.trim(),
        cityId: city.id,
        income: 100,
        level: 1
    });

    addHistory(
        "Відкрито магазин " + shopName +
        " у місті " + city.name
    );

    updateInterface();
    updatePeople();
}

function upgradeShop(id) {
    const shop = gameData.shops.find(item => item.id === id);

    if (!shop) return;

    const price = shop.level * 5000;

    if (gameData.money < price) {
        alert("Недостатньо гривень!");
        return;
    }

    gameData.money -= price;
    shop.level++;
    shop.income += 100;

    addHistory("Магазин " + shop.name + " покращено.");

    updateInterface();
    updatePeople();
}

function generateBotPopulation() {
    const city = getSelectedCity();

    if (!city) return;

    const botCount = Math.min(
        20,
        Math.floor(city.population / 500)
    );

    let created = 0;

    while (created < botCount) {
        const exists = gameData.workers.some(
            worker =>
                worker.cityId === city.id &&
                worker.bot
        );

        if (exists && created > 0) break;

        const job = jobTypes[
            Math.floor(Math.random() * jobTypes.length)
        ];

        gameData.workers.push({
            id: Date.now() + Math.random(),
            cityId: city.id,
            job: job.name,
            salary: job.salary,
            bot: true
        });

        created++;
    }

    addHistory(
        "У місті " + city.name +
        " з'явилися нові мешканці-боти."
    );

    updatePeople();
}

