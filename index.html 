function exportResource(id,amount){
 if(!game.started)return;

 amount=Math.floor(Number(amount));

 if(!Number.isFinite(amount)||amount<=0){
  showEvent("Вкажи правильну кількість для експорту.");
  return;
 }

 if(typeof game[id]!=="number"||game[id]<amount){
  showEvent("Недостатньо ресурсу для експорту.");
  return;
 }

 const price=resourcePrices[id];
 if(!price)return;

 const income=amount*price;

 game[id]-=amount;
 game.money+=income;

 game.trade.push({
  resource:id,
  amount:amount,
  income:income,
  year:game.year
 });

 showEvent("Експортовано "+amount+" одиниць ресурсу. Дохід: "+formatMoney(income));
 renderAll();
 renderTrade();
}

