function hireJob(jobIndex) {
    const city = getSelectedCity();

    if (!city) return;

    const job = jobTypes[jobIndex];

    if (!job) return;

    const worker = {
        id: Date.now() + Math.random(),
        cityId: city.id,
        job: job.name,
        salary: job.salary
    };

    gameData.workers.push(worker);

