// ЧАСТИНА 4 — РОЗВИТОК МІСТ ТА ЕКОНОМІКА
// ===================================

(() => {
  const map = document.getElementById("worldMap");
  const settlements = document.getElementById("settlements");
  const roads = document.getElementById("roads");
  const labels = document.getElementById("mapLabels");

  if (!map || !settlements || !roads || !labels) {
    console.error("Не знайдено шари для розвитку міст");
    return;
  }

  const ns = "http://www.w3.org/2000/svg";
  const vb = map.viewBox.baseVal;
  const W = vb.width || 1000;
  const H = vb.height || 700;

  const cityStyle = document.createElement("style");
  cityStyle.textContent = `
    .city-building {
      stroke: #302a23;
      stroke-width: 1.5;
    }
    .city-smoke {
      fill: #e9edf0;
      opacity: .35;
      animation: citySmoke 3s ease-in-out infinite;
    }
    .city-pulse {
      fill: none;
      stroke: #f5d17b;
      stroke-width: 2;
      animation: cityPulse 2.5s ease-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
    @keyframes citySmoke {
      0%,100% { opacity: .12; transform: translateY(0); }
      50% { opacity: .5; transform: translateY(-7px); }
    }
    @keyframes cityPulse {
      0% { opacity: .8; transform: scale(.7); }
      100% { opacity: 0; transform: scale(2.2); }
    }
  `;
  document.head.appendChild(cityStyle);

  function el(tag, attrs) {
    const node = document.createElementNS(ns, tag);
    Object.entries(attrs).forEach(([key, value]) => {
      node.setAttribute(key, value);
    });
    return node;
  }

  function getCountry() {
    return window.playerCountry || null;
  }

  function makeCity(x, y, name, size) {
    const group = el("g", {
      transform: `translate(${x} ${y})`,
      class: "developing-city"
    });

    group.appendChild(el("circle", {
      cx: 0, cy: 0, r: 19 + size * 2,
      class: "city-pulse"
    }));

    const houseCount = Math.min(12, 3 + size * 2);

    for (let i = 0; i < houseCount; i++) {
      const angle = i * 2.4;
      const radius = 8 + (i % 3) * 8;
      const hx = Math.cos(angle) * radius;
      const hy = Math.sin(angle) * radius;

      group.appendChild(el("rect", {
        x: hx - 4,
        y: hy - 4,
        width: 9,
        height: 8,
        rx: 1,
        fill: ["#bd8755", "#d5b16e", "#a96f51"][i % 3],
        class: "city-building"
      }));

      group.appendChild(el("polygon", {
        points: `${hx-5},${hy-4} ${hx},${hy-10} ${hx+5},${hy-4}`,
        fill: "#713f32",
        class: "city-building"
      }));
    }

    group.appendChild(el("circle", {
      cx: 5, cy: -15, r: 2,
      class: "city-smoke"
    }));

    group.appendChild(el("circle", {
      cx: 8, cy: -20, r: 3,
      class: "city-smoke"
    }));

    settlements.appendChild(group);

    const label = el("text", {
      x: x,
      y: y + 37,
      "text-anchor": "middle",
      fill: "#ffffff",
      "font-size": "13",
      "font-weight": "bold",
      "paint-order": "stroke",
      stroke: "#17212b",
      "stroke-width": "4"
    });

    label.textContent = name;
    labels.appendChild(label);

    return group;
  }

  function connectCities(a, b) {
    const line = el("path", {
      d: `M ${a.x} ${a.y} L ${b.x} ${b.y}`,
      fill: "none",
      stroke: "#c4a77b",
      "stroke-width": "4",
      "stroke-linecap": "round",
      "stroke-dasharray": "2 3",
      opacity: ".9"
    });

    roads.appendChild(line);
  }

  const initialCities = [
    {name: "Берегове", x: .17, y: .43},
    {name: "Лісоград", x: .42, y: .51},
    {name: "Златопіль", x: .73, y: .37}
  ];

  window.cityWorld = window.cityWorld || [];

  initialCities.forEach((city, index) => {
    const item = {
      name: city.name,
      x: city.x * W,
      y: city.y * H,
      population: 350 + index * 120,
      level: 1,
      houses: 3,
      isPlayerCity: false
    };

    window.cityWorld.push(item);
    makeCity(item.x, item.y, item.name, item.level);
  });

  function initializePlayerEconomy() {
    const country = getCountry();
    if (!country || country.economyInitialized) return;

    country.food = 500;
    country.wood = 300;
    country.stone = 200;
    country.iron = 50;
    country.population = country.population || 1000;
    country.treasury = country.treasury || 50000;
    country.buildings = {
      houses: 5,
      farms: 2,
      sawmills: 1,
      quarries: 1
    };
    country.economyInitialized = true;

    window.cityWorld.push({
      name: country.capital,
      x: country.x,
      y: country.y,
      population: country.population,
      level: 2,
      houses: 5,
      isPlayerCity: true
    });

    makeCity(country.x, country.y, country.capital, 2);
  }

  function developPlayerCountry() {
    const country = getCountry();
    if (!country || !country.economyInitialized) return;

    const buildings = country.buildings;

    country.food += buildings.farms * 8;
    country.wood += buildings.sawmills * 5;
    country.stone += buildings.quarries * 4;
    country.population += Math.max(1, Math.floor(
      country.population * 0.002
    ));

    country.treasury += Math.floor(country.population * 0.01);

    if (country.food > country.population * 0.1) {
      country.population += Math.floor(country.population * 0.001);
    }
  }

  window.buildCityBuilding = function(type) {
    const country = getCountry();

    if (!country || !country.economyInitialized) {
      return "Спочатку заснуй державу!";
    }

    const prices = {
      houses: {wood: 30, stone: 10},
      farms: {wood: 40, stone: 10},
      sawmills: {wood: 50, stone: 20},
      quarries: {wood: 30, stone: 30}
    };

    const price = prices[type];

    if (!price) return "Невідомий тип будівлі";

    if (country.wood < price.wood || country.stone < price.stone) {
      return "Недостатньо ресурсів!";
    }

    country.wood -= price.wood;
    country.stone -= price.stone;
    country.buildings[type] += 1;

    return "Будівлю успішно зведено!";
  };

  window.addNewCity = function(name, x, y) {
    const country = getCountry();

    if (!country || !country.economyInitialized) {
      return "Спочатку заснуй державу!";
    }

    if (!name || !Number.isFinite(x) || !Number.isFinite(y)) {
      return "Перевір назву та координати міста";
    }

    const city = {
      name: name,
      x: Math.max(10, Math.min(W - 10, x)),
      y: Math.max(10, Math.min(H - 10, y)),
      population: 100,
      level: 1,
      houses: 2,
      isPlayerCity: true
    };

    const previous = window.cityWorld.find(c => c.isPlayerCity);

    window.cityWorld.push(city);
    makeCity(city.x, city.y, city.name, city.level);

    if (previous) connectCities(previous, city);

    country.cities.push(name);
    return "Нове місто засновано!";
  };

  function runCityDevelopment() {
    initializePlayerEconomy();
    developPlayerCountry();

    window.cityWorld.forEach(city => {
      city.population += Math.max(
        1,
        Math.floor(city.population * 0.001)
      );

      if (city.population > 1000 && city.level < 3) {
        city.level++;
        city.houses += 2;
        makeCity(city.x, city.y, city.name, city.level);
      }
    });
  }

  window.runCityDevelopment = runCityDevelopment;

  console.log("Частина 4 завантажена");
})();

