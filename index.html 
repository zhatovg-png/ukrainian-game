
<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Держава — симулятор країни</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
*{box-sizing:border-box}
body{margin:0;background:#101820;color:#edf3f7;font-family:Arial,sans-serif}
header{background:#172733;padding:15px;border-bottom:1px solid #344957}
header h1{margin:0;font-size:23px}
header p{margin:6px 0 0;color:#a9bbc7;font-size:13px}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:12px;padding:12px}
#map{height:72vh;min-height:420px;border-radius:12px;border:1px solid #405563;background:#243541}
.panel{background:#192a36;border:1px solid #344957;border-radius:12px;padding:13px;margin-bottom:12px}
.panel h2{font-size:17px;margin:0 0 12px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.stat{background:#223744;border-radius:8px;padding:10px}
.stat small{display:block;color:#a9bbc7;margin-bottom:5px}
.stat strong{font-size:17px}
button,select,input{font:inherit}
button{background:#247c63;color:white;border:0;border-radius:8px;padding:10px 12px;cursor:pointer}
button:hover{filter:brightness(1.12)}
button:disabled{opacity:.45;cursor:not-allowed}
input,select{width:100%;background:#10202b;color:white;border:1px solid #496171;border-radius:8px;padding:11px;margin:5px 0 10px}
label{font-size:13px;color:#c3d1da}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.tabs button{background:#263d4b;font-size:12px;padding:9px}
.tabs button.active{background:#247c63}
.tabcontent{display:none}
.tabcontent.active{display:block}
.log{height:150px;overflow:auto;background:#10202b;border-radius:8px;padding:9px;font-size:12px;color:#c4d3dc}
.log p{margin:0 0 8px}
#setup{position:fixed;inset:0;background:#08121beF;z-index:10000;display:flex;align-items:center;justify-content:center;padding:15px}
.setupbox{width:min(440px,100%);background:#192c39;border:1px solid #496171;border-radius:15px;padding:20px}
.setupbox h2{margin-top:0}
.hint{color:#a9bbc7;font-size:12px;line-height:1.5}
#chosen{color:#8de0ba;font-size:13px;margin:8px 0}
.mapnote{font-size:12px;color:#a9bbc7;margin-top:8px}
.item{background:#223744;padding:10px;border-radius:8px;margin:7px 0}
.item button{margin-top:7px}
.row{display:flex;justify-content:space-between;gap:8px;align-items:center}
.row span{color:#b5c7d1;font-size:13px}
@media(max-width:850px){
.layout{grid-template-columns:1fr}
#map{height:55vh;min-height:350px}
}
</style>
</head>
<body>

<header>
<h1>🏛 ДЕРЖАВА</h1>
<p>Симулятор розвитку країни • Початок: 2016 рік</p>
</header>

<div class="layout">
<main>
<div class="panel">
<div class="row">
<h2>🗺 Карта України</h2>
<div>
<button id="pauseBtn">⏸ Пауза</button>
</div>
</div>
<div id="map"></div>
<div class="mapnote">Обирай місце на карті для заснування своєї столиці. Географія та ресурси в прототипі приблизні.</div>
</div>

<div class="panel">
<h2>📊 Стан держави</h2>
<div class="stats">
<div class="stat"><small>💰 Бюджет</small><strong id="money">—</strong></div>
<div class="stat"><small>👥 Населення</small><strong id="population">—</strong></div>
<div class="stat"><small>😊 Щастя</small><strong id="happiness">—</strong></div>
<div class="stat"><small>🌾 Їжа</small><strong id="food">—</strong></div>
<div class="stat"><small>🏙 Міста</small><strong id="cityCount">—</strong></div>
<div class="stat"><small>🏡 Села</small><strong id="villageCount">—</strong></div>
</div>
</div>
</main>

<aside>
<div class="panel">
<h2>📅 Час та управління</h2>
<div class="row"><span>Дата у грі</span><strong id="date">2016 рік</strong></div>
<div class="row"><span>Швидкість</span><strong id="speedLabel">1×</strong></div>
<div style="display:flex;gap:7px;margin-top:10px">
<button id="slower">−</button>
<button id="faster">+</button>
</div>
</div>

<div class="panel">
<div class="tabs">
<button class="active" data-tab="overview">Держава</button>
<button data-tab="build">Будівництво</button>
<button data-tab="economy">Економіка</button>
<button data-tab="people">Населення</button>
<button data-tab="logistics">Транспорт</button>
<button data-tab="politics">Вибори</button>
<button data-tab="bots">Країни</button>
<button data-tab="business">Бізнес</button>
</div>

<div id="overview" class="tabcontent active">
<h2>🏛 Моя держава</h2>
<div class="item">Назва: <strong id="countryNameView">Ще не створена</strong></div>
<div class="item">Столиця: <strong id="capitalView">Не обрана</strong></div>
<div class="item">Рік заснування: <strong>2016</strong></div>
<p class="hint">Обери територію на карті, створи столицю та починай розвиток своєї держави.</p>
</div>

<div id="build" class="tabcontent">
<h2>🏗 Будівництво</h2>
<div id="buildList"></div>
</div>

<div id="economy" class="tabcontent">
<h2>💰 Економіка</h2>
<div id="economyContent"></div>
</div>

<div id="people" class="tabcontent">
<h2>👥 Населення</h2>
<div id="peopleContent"></div>
</div>

<div id="logistics" class="tabcontent">
<h2>🚆 Транспорт та логістика</h2>
<div id="logisticsContent"></div>
</div>

<div id="politics" class="tabcontent">
<h2>🗳 Політика та вибори</h2>
<div id="politicsContent"></div>
</div>

<div id="bots" class="tabcontent">
<h2>🌍 Інші держави</h2>
<div id="botsContent"></div>
</div>

<div id="business" class="tabcontent">
<h2>🏪 Підприємництво</h2>
<div id="businessContent"></div>
</div>
</div>

<div class="panel">
<h2>📜 Події</h2>
<div class="log" id="eventLog">
<p>2016 рік. Світ чекає на нову державу...</p>
</div>
</div>
</aside>
</div>

<div id="setup">
<div class="setupbox">
<h2>🌍 Створи свою державу</h2>
<p class="hint">Обери місце на карті України, придумай назву держави та столиці.</p>
<label for="countryName">Назва держави</label>
<input id="countryName" maxlength="30" placeholder="Наприклад: Українська Республіка">
<label for="cityName">Назва столиці</label>
<input id="cityName" maxlength="30" placeholder="Наприклад: Новоград">
<div id="chosen">📍 Натисни на карту та обери місце</div>
<button id="foundBtn" disabled style="width:100%">Заснувати державу</button>
<p class="hint">Гра починається у 2016 році. Інші країни будуть керуватися комп'ютером.</p>
</div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>

const map = L.map("map").setView([48.7, 31.2], 6);

L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 18,
    attribution: "© OpenStreetMap"
}).addTo(map);

let selectedPlace = null;
let capitalMarker = null;
let paused = false;
let gameSpeed = 1;
let gameTimer = null;

const game = {
    started: false,
    year: 2016,
    month: 1,
    day: 1,
    country: "",
    capital: "",
    money: 1000000,
    population: 25000,
    happiness: 75,
    food: 50000,
    wood: 10000,
    stone: 8000,
    iron: 3000,
    coal: 2000,
    gas: 1000,
    oil: 500,
    cities: [],
    villages: [],
    buildings: [],
    businesses: [],
    roads: [],
    railways: [],
    bridges: [],
    bots: [],
    electionYear: 2020,
    lastElection: 2016,
    war: false,
    history: [],
    votes: 0
};

const resources = [
    {name:"Залізна руда", type:"iron", lat:48.1, lng:37.7},
    {name:"Вугілля", type:"coal", lat:48.2, lng:38.0},
    {name:"Газ", type:"gas", lat:49.5, lng:35.5},
    {name:"Нафта", type:"oil", lat:49.2, lng:24.0},
    {name:"Камінь", type:"stone", lat:48.5, lng:30.0},
    {name:"Ліс", type:"wood", lat:51.0, lng:25.0},
    {name:"Родючі землі", type:"grain", lat:48.0, lng:32.0}
];

const rivers = [
    {
        name:"Дніпро",
        points:[
            [51.5,33.0],[50.5,33.0],[49.8,32.5],
            [49.0,32.0],[48.5,32.2],[47.8,33.0],
            [46.7,32.0]
        ]
    },
    {
        name:"Дністер",
        points:[
            [49.0,26.0],[48.5,26.5],[48.0,27.0],
            [47.5,28.0],[46.5,30.0]
        ]
    },
    {
        name:"Південний Буг",
        points:[
            [49.5,27.0],[48.8,29.0],[48.0,30.0],
            [47.0,31.0],[46.5,31.8]
        ]
    },
    {
        name:"Десна",
        points:[
            [52.0,33.0],[51.5,32.5],[51.0,31.5],
            [50.5,31.3]
        ]
    },
    {
        name:"Сіверський Донець",
        points:[
            [50.0,37.0],[49.5,37.5],[49.0,38.0],
            [48.5,37.0],[48.0,36.8]
        ]
    }
];

rivers.forEach(river => {
    L.polyline(river.points,{
        color:"#40a9df",
        weight:3,
        opacity:0.8
    }).addTo(map).bindPopup("Річка: "+river.name);
});

resources.forEach(resource => {
    const marker = L.circleMarker(
        [resource.lat,resource.lng],
        {
            radius:7,
            color:"#f5d76e",
            fillColor:"#e7a928",
            fillOpacity:0.9
        }
    ).addTo(map);

    marker.bindPopup(
        "⛏ "+resource.name+
        "<br>Приблизна ресурсна зона"
    );
});

map.on("click", function(event) {
    if(game.started) return;

    const lat = event.latlng.lat;
    const lng = event.latlng.lng;

    if(lat < 44 || lat > 53.5 || lng < 22 || lng > 41) {
        document.getElementById("chosen").textContent =
            "⚠ Обери місце в межах України";
        selectedPlace = null;
        document.getElementById("foundBtn").disabled = true;
        return;
    }

    selectedPlace = {
        lat:lat,
        lng:lng
    };

    if(capitalMarker) {
        map.removeLayer(capitalMarker);
    }

    capitalMarker = L.marker([lat,lng]).addTo(map);
    capitalMarker.bindPopup("Місце майбутньої столиці").openPopup();

    document.getElementById("chosen").textContent =
        "📍 Обрано координати: "+
        lat.toFixed(3)+", "+lng.toFixed(3);

    document.getElementById("foundBtn").disabled = false;
});

const botCountries = [
    {
        name:"Польща",
        capital:"Варшава",
        population:37000000,
        money:800000000,
        development:75,
        happiness:72
    },
    {
        name:"Білорусь",
        capital:"Мінськ",
        population:9200000,
        money:150000000,
        development:55,
        happiness:60
    },
    {
        name:"Словаччина",
        capital:"Братислава",
        population:5400000,
        money:120000000,
        development:70,
        happiness:74
    },
    {
        name:"Угорщина",
        capital:"Будапешт",
        population:9600000,
        money:170000000,
        development:68,
        happiness:70
    },
    {
        name:"Румунія",
        capital:"Бухарест",
        population:19000000,
        money:250000000,
        development:65,
        happiness:73
    },
    {
        name:"Молдова",
        capital:"Кишинів",
        population:2500000,
        money:30000000,
        development:45,
        happiness:68
    }
];

game.bots = botCountries.map(country => ({
    ...country,
    cities:Math.max(2,Math.floor(country.population/3000000)),
    villages:Math.max(5,Math.floor(country.population/500000))
}));

function addLog(message) {
    const log = document.getElementById("eventLog");
    const entry = document.createElement("p");

    entry.textContent =
        game.year+" рік: "+message;

    log.prepend(entry);

    while(log.children.length > 60) {
        log.removeChild(log.lastChild);
    }
}

function formatNumber(value) {
    return Math.floor(value).toLocaleString("uk-UA");
}

function updateStats() {
    document.getElementById("money").textContent =
        formatNumber(game.money)+" ₴";

    document.getElementById("population").textContent =
        formatNumber(game.population);

    document.getElementById("happiness").textContent =
        Math.round(game.happiness)+"%";

    document.getElementById("food").textContent =
        formatNumber(game.food);

    document.getElementById("cityCount").textContent =
        game.cities.length;

    document.getElementById("villageCount").textContent =
        game.villages.length;

    document.getElementById("date").textContent =
        game.day+"."+String(game.month).padStart(2,"0")+
        "."+game.year;
}

function updateCountryInfo() {
    document.getElementById("countryNameView").textContent =
        game.country || "Ще не створена";

    document.getElementById("capitalView").textContent =
        game.capital || "Не обрана";
}

document.getElementById("foundBtn").addEventListener("click",function() {
    const countryName =
        document.getElementById("countryName").value.trim();

    const cityName =
        document.getElementById("cityName").value.trim();

    if(!countryName || !cityName || !selectedPlace) {
        alert("Заповни назви та обери місце на карті!");
        return;
    }

    game.country = countryName;
    game.capital = cityName;
    game.started = true;

    const capital = {
        name:cityName,
        lat:selectedPlace.lat,
        lng:selectedPlace.lng,
        population:game.population,
        isCapital:true
    };

    game.cities.push(capital);

    if(capitalMarker) {
        capitalMarker.bindPopup(
            "🏛 "+cityName+"<br>Столиця держави "+countryName
        );
    }

    document.getElementById("setup").style.display = "none";

    updateCountryInfo();
    updateStats();

    addLog("Засновано державу "+countryName+
        ". Столиця — "+cityName+".");

    addLog("Уряд починає розбудову країни.");

    renderAll();
    startGame();
});

document.querySelectorAll("[data-tab]").forEach(button => {
    button.addEventListener("click",function() {
        document.querySelectorAll("[data-tab]").forEach(item => {
            item.classList.remove("active");
        });

        document.querySelectorAll(".tabcontent").forEach(item => {
            item.classList.remove("active");
        });

        button.classList.add("active");

        const target = document.getElementById(
            button.dataset.tab
        );

        if(target) target.classList.add("active");
    });
});

document.getElementById("pauseBtn").addEventListener("click",function() {
    paused = !paused;

    this.textContent = paused ? "▶ Продовжити" : "⏸ Пауза";
});

document.getElementById("faster").addEventListener("click",function() {
    gameSpeed = Math.min(5,gameSpeed+1);

    document.getElementById("speedLabel").textContent =
        gameSpeed+"×";

    restartGameTimer();
});

document.getElementById("slower").addEventListener("click",function() {
    gameSpeed = Math.max(1,gameSpeed-1);

    document.getElementById("speedLabel").textContent =
        gameSpeed+"×";

    restartGameTimer();
});

const buildingTypes = [
    {id:"house",name:"Житловий будинок",icon:"🏠",price:25000,wood:20,stone:10,population:80,description:"Збільшує місткість населення"},
    {id:"farm",name:"Ферма",icon:"🌾",price:40000,wood:30,stone:10,food:0,description:"Виробляє їжу"},
    {id:"market",name:"Ринок",icon:"🏪",price:55000,wood:25,stone:20,description:"Покращує торгівлю"},
    {id:"school",name:"Школа",icon:"🏫",price:90000,wood:30,stone:60,description:"Покращує освіту"},
    {id:"hospital",name:"Лікарня",icon:"🏥",price:140000,wood:40,stone:100,description:"Покращує здоров'я"},
    {id:"factory",name:"Завод",icon:"🏭",price:180000,wood:50,stone:100,iron:30,description:"Розвиває промисловість"},
    {id:"sawmill",name:"Лісопилка",icon:"🪵",price:70000,wood:40,stone:20,description:"Виробляє деревину",resource:"wood"},
    {id:"quarry",name:"Кам'яний кар'єр",icon:"🪨",price:85000,wood:30,stone:30,description:"Видобуває камінь",resource:"stone"},
    {id:"ironmine",name:"Залізна шахта",icon:"⛏️",price:160000,wood:50,stone:70,iron:20,description:"Потребує залізної ресурсної зони",resource:"iron",requiresDeposit:true},
    {id:"coalmine",name:"Вугільна шахта",icon:"⚒️",price:130000,wood:50,stone:60,description:"Потребує вугільної ресурсної зони",resource:"coal",requiresDeposit:true},
    {id:"gasplant",name:"Газовидобувна станція",icon:"🔥",price:190000,wood:40,stone:80,iron:20,description:"Потребує газової ресурсної зони",resource:"gas",requiresDeposit:true},
    {id:"oilplant",name:"Нафтова станція",icon:"🛢️",price:220000,wood:40,stone:80,iron:30,description:"Потребує нафтової ресурсної зони",resource:"oil",requiresDeposit:true},
    {id:"power",name:"Електростанція",icon:"⚡",price:250000,wood:40,stone:120,iron:50,description:"Забезпечує енергією"},
    {id:"port",name:"Морський порт",icon:"⚓",price:300000,wood:80,stone:150,iron:40,description:"Дозволений лише поблизу моря",requiresCoast:true},
    {id:"barracks",name:"Казарми",icon:"🛡️",price:120000,wood:40,stone:70,description:"Підтримують державну оборону"},
    {id:"church",name:"Церква",icon:"⛪",price:60000,wood:40,stone:50,description:"Підвищує добробут"},
    {id:"road",name:"Дорога",icon:"🛣️",price:15000,wood:10,stone:15,description:"Покращує сполучення"},
    {id:"railway",name:"Залізниця",icon:"🚆",price:90000,wood:20,stone:80,iron:30,description:"Покращує перевезення"},
    {id:"bridge",name:"Міст",icon:"🌉",price:110000,wood:50,stone:70,iron:40,description:"З'єднує береги річок"}
];

function getResourceAmount(name) {
    return Number(game[name] || 0);
}

function canAffordBuilding(building) {
    if(game.money < building.price) return false;

    const required = ["wood","stone","iron"];

    for(const resource of required) {
        const amount = building[resource] || 0;

        if(getResourceAmount(resource) < amount) {
            return false;
        }
    }

    return true;
}

function isNearResource(building) {
    if(!building.requiresDeposit) return true;

    if(!selectedPlace) return false;

    const deposit = resources.find(resource => {
        if(resource.type !== building.resource) return false;

        const distance = map.distance(
            [selectedPlace.lat,selectedPlace.lng],
            [resource.lat,resource.lng]
        );

        return distance < 90000;
    });

    return Boolean(deposit);
}

function isNearCoast() {
    if(!selectedPlace) return false;

    const lat = selectedPlace.lat;
    const lng = selectedPlace.lng;

    return lat < 47.5 || lng < 29.5 || lng > 39.5;
}

function buildStructure(buildingId) {
    if(!game.started) {
        alert("Спочатку створи державу!");
        return;
    }

    const building = buildingTypes.find(item => item.id === buildingId);

    if(!building) return;

    if(!canAffordBuilding(building)) {
        alert("Недостатньо грошей або матеріалів!");
        return;
    }

    if(building.requiresDeposit && !isNearResource(building)) {
        alert("Для цього підприємства потрібна відповідна ресурсна зона!");
        return;
    }

    if(building.requiresCoast && !isNearCoast()) {
        alert("Морський порт можна будувати лише поблизу узбережжя!");
        return;
    }

    game.money -= building.price;
    game.wood -= building.wood || 0;
    game.stone -= building.stone || 0;
    game.iron -= building.iron || 0;

    const structure = {
        id:building.id,
        name:building.name,
        x:game.capital,
        created:game.year,
        level:1
    };

    game.buildings.push(structure);

    if(building.id === "house") {
        game.population += building.population;
    }

    if(building.id === "farm") {
        game.food += 1000;
    }

    if(building.id === "school") {
        game.happiness = Math.min(100,game.happiness+1);
    }

    if(building.id === "hospital") {
        game.happiness = Math.min(100,game.happiness+2);
    }

    if(building.id === "church") {
        game.happiness = Math.min(100,game.happiness+2);
    }

    addLog("Побудовано: "+building.name+".");
    updateStats();
    renderAll();
}

function renderBuildings() {
    const container = document.getElementById("buildList");

    container.innerHTML = "";

    buildingTypes.forEach(building => {
        const element = document.createElement("div");
        element.className = "item";

        const costs = [
            "💰 "+formatNumber(building.price)+" ₴",
            "🪵 "+(building.wood || 0),
            "🪨 "+(building.stone || 0),
            "🔩 "+(building.iron || 0)
        ].join(" • ");

        element.innerHTML = `
            <strong>${building.icon} ${building.name}</strong>
            <p class="hint">${building.description}</p>
            <p class="hint">${costs}</p>
            <button type="button">Побудувати</button>
        `;

        element.querySelector("button").addEventListener("click",() => {
            buildStructure(building.id);
        });

        container.appendChild(element);
    });
}

function createVillage() {
    if(game.villages.length >= 100) return;

    const capital = game.cities[0];

    if(!capital) return;

    const offsetLat = (Math.random()-0.5)*0.5;
    const offsetLng = (Math.random()-0.5)*0.7;

    const village = {
        name:"Село "+(game.villages.length+1),
        lat:capital.lat+offsetLat,
        lng:capital.lng+offsetLng,
        population:100+Math.floor(Math.random()*300),
        growth:1
    };

    game.villages.push(village);

    L.circleMarker([village.lat,village.lng],{
        radius:5,
        color:"#a5d66d",
        fillColor:"#8bbd50",
        fillOpacity:0.9
    }).addTo(map).bindPopup(
        "🏡 "+village.name+
        "<br>Населення: "+village.population
    );

    addLog("Засновано нове село: "+village.name+".");
}

function villageGrowth() {
    game.villages.forEach(village => {
        village.population += Math.floor(
            village.population*0.002
        );

        if(village.population >= 1500) {
            const city = {
                name:village.name.replace("Село","Місто"),
                lat:village.lat,
                lng:village.lng,
                population:village.population,
                isCapital:false
            };

            game.cities.push(city);

            L.marker([city.lat,city.lng]).addTo(map)
                .bindPopup("🏙 "+city.name+
                    "<br>Населення: "+city.population);

            addLog(village.name+" отримало статус міста.");

            village.population = 0;
        }
    });

    game.villages = game.villages.filter(village =>
        village.population > 0
    );
}

function populationGrowth() {
    let housing = game.buildings.filter(item =>
        item.id === "house"
    ).length;

    let capacity = 25000 + housing*80;

    if(game.population < capacity && game.food > 0) {
        game.population += Math.max(
            1,
            Math.floor(game.population*0.0005)
        );
    }

    if(game.food <= 0) {
        game.happiness = Math.max(0,game.happiness-2);
        game.population = Math.max(
            100,
            game.population-Math.floor(game.population*0.0005)
        );
    }

    game.cities.forEach(city => {
        if(city.isCapital) {
            city.population = game.population;
        }
    });
}

function renderPeople() {
    const container = document.getElementById("peopleContent");

    const cityHtml = game.cities.map(city => `
        <div class="item">
            🏙 <strong>${city.name}</strong>
            <br>Населення: ${formatNumber(city.population)}
            ${city.isCapital ? "<br>⭐ Столиця" : ""}
        </div>
    `).join("");

    const villageHtml = game.villages.map(village => `
        <div class="item">
            🏡 <strong>${village.name}</strong>
            <br>Населення: ${formatNumber(village.population)}
        </div>
    `).join("");

    container.innerHTML =
        "<p>Загальне населення: "+formatNumber(game.population)+"</p>"+
        cityHtml+villageHtml;
}

function renderEconomy() {
    const container = document.getElementById("economyContent");

    container.innerHTML = `
        <div class="item">💰 Бюджет: ${formatNumber(game.money)} ₴</div>
        <div class="item">🌾 Їжа: ${formatNumber(game.food)}</div>
        <div class="item">🪵 Деревина: ${formatNumber(game.wood)}</div>
        <div class="item">🪨 Камінь: ${formatNumber(game.stone)}</div>
        <div class="item">🔩 Залізо: ${formatNumber(game.iron)}</div>
        <div class="item">⚫ Вугілля: ${formatNumber(game.coal)}</div>
        <div class="item">🔥 Газ: ${formatNumber(game.gas)}</div>
        <div class="item">🛢️ Нафта: ${formatNumber(game.oil)}</div>
    `;
}

function renderAll() {
    renderBuildings();
    renderEconomy();
    renderPeople();
}

function renderLogistics() {
    const container = document.getElementById("logisticsContent");

    container.innerHTML = `
        <div class="item">🛣️ Дороги: ${game.roads.length}</div>
        <div class="item">🚆 Залізниці: ${game.railways.length}</div>
        <div class="item">🌉 Мости: ${game.bridges.length}</div>
        <p class="hint">Транспортні споруди будуються окремо та потребують фінансування.</p>
        <button id="roadBtn">Побудувати дорогу — 15 000 ₴</button>
        <button id="railBtn">Побудувати залізницю — 90 000 ₴</button>
        <button id="bridgeBtn">Побудувати міст — 110 000 ₴</button>
    `;

    document.getElementById("roadBtn").onclick = () => {
        if(game.money < 15000) {
            alert("Недостатньо грошей!");
            return;
        }

        game.money -= 15000;
        game.roads.push({year:game.year});
        addLog("Побудовано нову дорогу.");
        renderAll();
        renderLogistics();
        updateStats();
    };

    document.getElementById("railBtn").onclick = () => {
        if(game.money < 90000 || game.iron < 30 || game.stone < 80) {
            alert("Недостатньо грошей або матеріалів!");
            return;
        }

        game.money -= 90000;
        game.iron -= 30;
        game.stone -= 80;
        game.railways.push({year:game.year});
        addLog("Побудовано залізничну ділянку.");
        renderLogistics();
        updateStats();
    };

    document.getElementById("bridgeBtn").onclick = () => {
        if(game.money < 110000 || game.iron < 40 || game.stone < 70) {
            alert("Недостатньо грошей або матеріалів!");
            return;
        }

        game.money -= 110000;
        game.iron -= 40;
        game.stone -= 70;

        game.bridges.push({
            year:game.year,
            condition:100,
            temporary:false
        });

        addLog("Збудовано новий міст.");
        renderLogistics();
        updateStats();
    };
}

function createBusiness(name,price,income) {
    if(game.money < price) {
        alert("Недостатньо грошей!");
        return;
    }

    game.money -= price;

    game.businesses.push({
        name:name,
        income:income,
        level:1,
        workers:10
    });

    addLog("Відкрито підприємство: "+name+".");
    renderBusiness();
    updateStats();
}

function renderBusiness() {
    const container = document.getElementById("businessContent");

    container.innerHTML = `
        <p>Підприємства держави: ${game.businesses.length}</p>
        <div class="item">
            <strong>🏪 Магазин</strong>
            <p class="hint">Вартість: 30 000 ₴. Дохід: 1 000 ₴ за ігровий день.</p>
            <button id="shopCreate">Відкрити магазин</button>
        </div>
        <div class="item">
            <strong>🍞 Пекарня</strong>
            <p class="hint">Вартість: 45 000 ₴. Дохід: 1 500 ₴ за ігровий день.</p>
            <button id="bakeryCreate">Відкрити пекарню</button>
        </div>
        <div class="item">
            <strong>🏭 Майстерня</strong>
            <p class="hint">Вартість: 70 000 ₴. Дохід: 2 500 ₴ за ігровий день.</p>
            <button id="workshopCreate">Відкрити майстерню</button>
        </div>
    `;

    document.getElementById("shopCreate").onclick =
        () => createBusiness("Магазин",30000,1000);

    document.getElementById("bakeryCreate").onclick =
        () => createBusiness("Пекарня",45000,1500);

    document.getElementById("workshopCreate").onclick =
        () => createBusiness("Майстерня",70000,2500);
}

function renderPolitics() {
    const container = document.getElementById("politicsContent");

    const nextElection = game.electionYear;

    container.innerHTML = `
        <div class="item">🗳 Наступні вибори: ${nextElection} рік</div>
        <div class="item">Ваш рейтинг: ${Math.round(game.happiness)}%</div>
        <div class="item">Кандидат від опозиції: Комп'ютерний суперник</div>
        <button id="electionBtn">Провести вибори</button>
        <p class="hint">Результат залежить від добробуту населення та випадкових подій.</p>
    `;

    document.getElementById("electionBtn").onclick = () => {
        if(game.year < game.electionYear) {
            alert("Вибори ще не настали!");
            return;
        }

        const playerVotes = Math.max(
            0,
            Math.min(100,Math.round(game.happiness + Math.random()*20-10))
        );

        const botVotes = 100-playerVotes;

        if(playerVotes >= botVotes) {
            addLog("На виборах переміг чинний уряд.");
        } else {
            addLog("На виборах переміг комп'ютерний суперник. Уряд змінився.");
            game.happiness = Math.max(20,game.happiness-3);
        }

        game.lastElection = game.year;
        game.electionYear = game.year+4;

        renderPolitics();
        updateStats();
    };
}

function updateBots() {
    game.bots.forEach(bot => {
        const growth = bot.population*0.00003;

        bot.population += Math.floor(growth);
        bot.money += Math.floor(bot.money*0.0002);

        if(Math.random() < 0.15) {
            bot.development = Math.min(
                100,
                bot.development+1
            );
        }

        if(Math.random() < 0.08) {
            bot.happiness = Math.max(
                20,
                Math.min(100,bot.happiness+(Math.random()*4-2))
            );
        }
    });
}

function renderBots() {
    const container = document.getElementById("botsContent");

    container.innerHTML = game.bots.map(bot => `
        <div class="item">
            <strong>🌍 ${bot.name}</strong>
            <p class="hint">Столиця: ${bot.capital}</p>
            <p class="hint">Населення: ${formatNumber(bot.population)}</p>
            <p class="hint">Розвиток: ${Math.round(bot.development)}%</p>
            <p class="hint">Добробут: ${Math.round(bot.happiness)}%</p>
        </div>
    `).join("");
}

function dailyBusinessIncome() {
    game.businesses.forEach(business => {
        game.money += business.income;
    });
}

function dailyEconomy() {
    const farms = game.buildings.filter(item =>
        item.id === "farm"
    ).length;

    const factories = game.buildings.filter(item =>
        item.id === "factory"
    ).length;

    const sawmills = game.buildings.filter(item =>
        item.id === "sawmill"
    ).length;

    const quarries = game.buildings.filter(item =>
        item.id === "quarry"
    ).length;

    game.food += farms*150;
    game.wood += sawmills*10;
    game.stone += quarries*10;
    game.money += factories*500;

    const taxIncome = Math.floor(game.population*0.15);

    game.money += taxIncome;

    const foodConsumption = Math.floor(game.population*0.02);

    game.food = Math.max(0,game.food-foodConsumption);

    if(game.war) {
        game.money = Math.max(0,game.money-5000);
        game.happiness = Math.max(0,game.happiness-0.2);
    }

    dailyBusinessIncome();
}

function randomEvent() {
    const events = [
        {
            text:"Урожай був особливо добрим.",
            action:() => game.food += 3000
        },
        {
            text:"Місцеві підприємці відкрили нові справи.",
            action:() => game.money += 10000
        },
        {
            text:"До столиці приїхали нові мешканці.",
            action:() => game.population += 250
        },
        {
            text:"Населення організувало міський ярмарок.",
            action:() => game.happiness = Math.min(100,game.happiness+2)
        },
        {
            text:"Державі довелося витратити кошти на ремонт доріг.",
            action:() => game.money = Math.max(0,game.money-8000)
        }
    ];

    const event = events[Math.floor(Math.random()*events.length)];

    event.action();
    addLog(event.text);
}

function renderAll() {
    renderBuildings();
    renderEconomy();
    renderPeople();
    renderLogistics();
    renderBusiness();
    renderPolitics();
    renderBots();
}

function advanceOneDay() {
    if(!game.started || paused) return;

    game.day++;

    if(game.day > 30) {
        game.day = 1;
        game.month++;

        if(game.month > 12) {
            game.month = 1;
            game.year++;

            addLog("Розпочався "+game.year+" рік.");
        }
    }

    dailyEconomy();
    populationGrowth();
    villageGrowth();
    updateBots();

    if(Math.random() < 0.025) {
        randomEvent();
    }

    if(game.day === 1 && Math.random() < 0.35) {
        createVillage();
    }

    updateStats();
    renderAll();
}

function startGame() {
    if(gameTimer) {
        clearInterval(gameTimer);
    }

    gameTimer = setInterval(
        advanceOneDay,
        3000/gameSpeed
    );
}

function restartGameTimer() {
    if(game.started) {
        startGame();
    }
}

function saveGame() {
    try {
        const saveData = {
            game:game,
            paused:paused,
            gameSpeed:gameSpeed
        };

        localStorage.setItem(
            "derzhavaSimulatorSave",
            JSON.stringify(saveData)
        );
    } catch(error) {
        console.error("Помилка збереження:",error);
    }
}

function loadGame() {
    try {
        const saved = localStorage.getItem(
            "derzhavaSimulatorSave"
        );

        if(!saved) return false;

        const data = JSON.parse(saved);

        if(!data || !data.game || !data.game.started) {
            return false;
        }

        Object.assign(game,data.game);

        paused = Boolean(data.paused);
        gameSpeed = Math.max(
            1,
            Math.min(5,Number(data.gameSpeed) || 1)
        );

        return true;
    } catch(error) {
        console.error("Помилка завантаження:",error);
        return false;
    }
}

function restoreMapObjects() {
    game.cities.forEach(city => {
        const marker = L.marker([city.lat,city.lng]).addTo(map);

        marker.bindPopup(
            (city.isCapital ? "🏛 " : "🏙 ")+
            city.name+
            "<br>Населення: "+formatNumber(city.population)
        );
    });

    game.villages.forEach(village => {
        L.circleMarker([village.lat,village.lng],{
            radius:5,
            color:"#a5d66d",
            fillColor:"#8bbd50",
            fillOpacity:0.9
        }).addTo(map).bindPopup(
            "🏡 "+village.name+
            "<br>Населення: "+formatNumber(village.population)
        );
    });

    if(game.cities.length > 0) {
        map.setView(
            [game.cities[0].lat,game.cities[0].lng],
            8
        );
    }
}

function exportSave() {
    const data = JSON.stringify({
        game:game,
        paused:paused,
        gameSpeed:gameSpeed
    },null,2);

    const blob = new Blob([data],{
        type:"application/json"
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "derzhava-save.json";
    link.click();

    URL.revokeObjectURL(url);
}

function importSave(file) {
    if(!file) return;

    const reader = new FileReader();

    reader.onload = function() {
        try {
            const data = JSON.parse(reader.result);

            if(!data.game || !data.game.started) {
                throw new Error("Неправильний файл збереження");
            }

            Object.assign(game,data.game);

            paused = Boolean(data.paused);
            gameSpeed = Math.max(
                1,
                Math.min(5,Number(data.gameSpeed) || 1)
            );

            localStorage.setItem(
                "derzhavaSimulatorSave",
                JSON.stringify({
                    game:game,
                    paused:paused,
                    gameSpeed:gameSpeed
                })
            );

            location.reload();
        } catch(error) {
            alert("Не вдалося завантажити збереження.");
        }
    };

    reader.readAsText(file);
}

function addSaveControls() {
    const panel = document.createElement("div");

    panel.className = "panel";

    panel.innerHTML = `
        <h2>💾 Збереження</h2>
        <button id="saveNow">Зберегти</button>
        <button id="exportNow">Експорт</button>
        <label for="importFile">Імпорт збереження</label>
        <input type="file" id="importFile" accept=".json">
    `;

    document.querySelector("aside").appendChild(panel);

    document.getElementById("saveNow").onclick = () => {
        saveGame();
        alert("Гру збережено!");
    };

    document.getElementById("exportNow").onclick = exportSave;

    document.getElementById("importFile").onchange = event => {
        importSave(event.target.files[0]);
    };
}

setInterval(() => {
    if(game.started) saveGame();
},10000);

addSaveControls();

const loadedGame = loadGame();

if(loadedGame) {
    document.getElementById("setup").style.display = "none";

    updateCountryInfo();
    updateStats();
    restoreMapObjects();
    renderAll();

    document.getElementById("speedLabel").textContent =
        gameSpeed+"×";

    document.getElementById("pauseBtn").textContent =
        paused ? "▶ Продовжити" : "⏸ Пауза";

    addLog("Завантажено попереднє збереження.");
    startGame();
}

</script>
</body>
</html>
