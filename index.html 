    const container = document.getElementById("politicsContent");

    if (!container) return;

    const playerVotes = gameData.elections.playerVotes;
    const rivalVotes = gameData.elections.rivalVotes;

    container.innerHTML = `
        <p>Держава: ${escapeHTML(gameData.country)}</p>
        <p>Останні вибори: ${gameData.elections.lastElection}</p>
        <p>Твої голоси: ${playerVotes}</p>
        <p>Голоси конкурента: ${rivalVotes}</p>
        <button onclick="startElection()">
