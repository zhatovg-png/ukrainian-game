<script>

// ======================================
// ГЛОБАЛЬНІ ЗМІННІ НОВОЇ ГРИ
// ======================================

window.selectedLocation = null;
window.gameStarted = false;
window.playerCountry = null;
window.worldStates = [];
window.worldResources = [];

const worldMap = document.getElementById("worldMap");
const markerLayer = document.getElementById("mapMarkers");
const miniMarker = document.getElementById("miniMarker");

const SVG_NS = "http://www.w3.org/2000/svg";

let selectedMarker = null;

// ======================================
// ПОВІДОМЛЕННЯ
// ======================================

function showMessage(message){
 let box=document.getElementById("foundingMessage");

 if(!box){
  box=document.createElement("div");
  box.id="foundingMessage";
  document.body.appendChild(box);
 }

 box.textContent=message;
 box.style.display="block";

 clearTimeout(window.foundingMessageTimer);

 window.foundingMessageTimer=setTimeout(()=>{
  box.style.display="none";
 },3000);
}

// ======================================
// КООРДИНАТИ КАРТИ
// ======================================

function getMapCoordinates(element,event){

 const rect=element.getBoundingClientRect();
 const view=element.viewBox.baseVal;

 if(!rect.width || !rect.height)return null;

 const x=(event.clientX-rect.left)/rect.width*view.width;
 const y=(event.clientY-rect.top)/rect.height*view.height;

 return {
  x:Math.max(0,Math.min(view.width,x)),
  y:Math.max(0,Math.min(view.height,y))
 };
}

// ======================================
// СТВОРЕННЯ МІТКИ
// ======================================

function updateMarkerPosition(x,y){

 window.selectedLocation={x,y};

 const markerHTML=`
  <circle cx="${x}" cy="${y}" r="25"
  fill="#ff4138" fill-opacity=".35"
  stroke="#ffffff" stroke-width="7"/>

  <circle cx="${x}" cy="${y}" r="9"
  fill="#ff4138" stroke="#ffffff" stroke-width="4"/>
 `;

 miniMarker.innerHTML=markerHTML;

 document.getElementById("setupMiniMarker").innerHTML=markerHTML;

 if(!selectedMarker){

  selectedMarker=document.createElementNS(SVG_NS,"g");

  selectedMarker.setAttribute("pointer-events","none");

  selectedMarker.innerHTML=`
   <circle cx="0" cy="0" r="20"
   fill="#ff4138" fill-opacity=".35"
   stroke="#ffffff" stroke-width="3"/>

   <circle cx="0" cy="0" r="7"
   fill="#ff4138" stroke="#ffffff" stroke-width="3"/>
  `;

  markerLayer.appendChild(selectedMarker);
 }

 selectedMarker.setAttribute(
  "transform",
  `translate(${x} ${y})`
 );
}

// ======================================
// ВИБІР МІСЦЯ
// ======================================

function selectMapPoint(element,event){

 if(window.gameStarted)return;

 event.preventDefault();

 const point=getMapCoordinates(element,event);

 if(!point)return;

 updateMarkerPosition(point.x,point.y);
}

// ======================================
// ОБРОБНИКИ КАРТ
// ======================================

worldMap.addEventListener("pointerdown",event=>{
 selectMapPoint(worldMap,event);
});

document.getElementById("miniMap")
.addEventListener("pointerdown",event=>{
 selectMapPoint(event.currentTarget,event);
});

document.getElementById("setupMiniMap")
.addEventListener("pointerdown",event=>{
 selectMapPoint(event.currentTarget,event);
});

console.log("Нова основа гри завантажена");

// ======================================
// ЧАСТИНУ 2 ВСТАВИТИ НИЖЧЕ
// НЕ ЗАКРИВАТИ SCRIPT!
// ======================================

// ======================================
// ЧАСТИНА 2 — ДЕРЖАВИ ТА РЕСУРСИ
// ======================================

(() => {

 const svg=document.getElementById("worldMap");
 const territories=document.getElementById("territories");
 const resources=document.getElementById("resources");
 const labels=document.getElementById("mapLabels");

 if(!svg || !territories || !resources || !labels){
  console.error("Помилка частини 2: відсутні шари карти");
  return;
 }

 const W=1000;
 const H=700;
 const NS="http://www.w3.org/2000/svg";

 function makeElement(tag,attrs={}){
  const el=document.createElementNS(NS,tag);

  Object.entries(attrs).forEach(([key,value])=>{
   el.setAttribute(key,value);
  });

  return el;
 }

 // ======================================
 // ВИГАДАНІ ДЕРЖАВИ
 // ======================================

 const worldStates=[
  {
   id:1,
   name:"Королівство Вестмар",
   capital:"Вестград",
   color:"#d9a441",
   population:28400,
   treasury:85000,
   points:[
    [80,175],[150,125],[245,135],
    [320,185],[350,275],[300,345],
    [210,375],[115,330],[65,250]
   ]
  },
  {
   id:2,
   name:"Союз Нордвік",
   capital:"Нордбург",
   color:"#5998bd",
   population:19300,
   treasury:62000,
   points:[
    [370,105],[455,75],[550,100],
    [625,155],[640,235],[570,300],
    [475,310],[390,255],[350,180]
   ]
  },
  {
   id:3,
   name:"Республіка Есталія",
   capital:"Есталь",
   color:"#75a66a",
   population:31600,
   treasury:105000,
   points:[
    [650,270],[740,245],[850,290],
    [920,365],[900,445],[815,485],
    [730,455],[665,385],[625,320]
   ]
  },
  {
   id:4,
   name:"Гірська держава Арден",
   capital:"Арденбург",
   color:"#a77ab8",
   population:14700,
   treasury:47000,
   points:[
    [240,410],[330,370],[425,410],
    [475,485],[440,570],[360,630],
    [275,600],[220,520]
   ]
  },
  {
   id:5,
   name:"Федерація Солар",
   capital:"Сонцеград",
   color:"#cf765d",
   population:22100,
   treasury:73000,
   points:[
    [510,390],[590,350],[680,390],
    [710,470],[665,550],[570,570],
    [495,510]
   ]
  }
 ];

 // ======================================
 // МАЛЮВАННЯ ТЕРИТОРІЙ
 // ======================================

 worldStates.forEach(state=>{

  const points=state.points
   .map(([x,y])=>`${x},${y}`)
   .join(" ");

  const polygon=makeElement("polygon",{
   points,
   fill:state.color,
   "fill-opacity":"0.25",
   stroke:state.color,
   "stroke-width":"5",
   "stroke-linejoin":"round",
   class:"country-territory",
   "data-state-id":state.id
  });

  territories.appendChild(polygon);

  const centerX=state.points.reduce(
   (sum,p)=>sum+p[0],0
  )/state.points.length;

  const centerY=state.points.reduce(
   (sum,p)=>sum+p[1],0
  )/state.points.length;

  const name=makeElement("text",{
   x:centerX,
   y:centerY,
   "text-anchor":"middle",
   fill:"#ffffff",
   "font-size":"17",
   "font-weight":"bold",
   "paint-order":"stroke",
   stroke:"#17212b",
   "stroke-width":"5",
   "stroke-linejoin":"round",
   class:"country-label"
  });

  name.textContent=state.name;
  labels.appendChild(name);

  const capital=makeElement("text",{
   x:centerX,
   y:centerY+23,
   "text-anchor":"middle",
   fill:"#fff1bd",
   "font-size":"13",
   "font-weight":"bold",
   "paint-order":"stroke",
   stroke:"#17212b",
   "stroke-width":"4"
  });

  capital.textContent="★ "+state.capital;
  labels.appendChild(capital);

  state.center={
   x:centerX,
   y:centerY
  };
 });

 window.worldStates=worldStates;

 // ======================================
 // ПРИРОДНІ РЕСУРСИ
 // ======================================

 const worldResources=[
  {id:1,name:"Залізо",x:130,y:260,color:"#c5cbd2",symbol:"◆"},
  {id:2,name:"Золото",x:270,y:205,color:"#ffd34f",symbol:"◆"},
  {id:3,name:"Вугілля",x:420,y:170,color:"#424a55",symbol:"◆"},
  {id:4,name:"Ліс",x:475,y:250,color:"#61b86b",symbol:"♣"},
  {id:5,name:"Мідь",x:700,y:345,color:"#d88b55",symbol:"◆"},
  {id:6,name:"Залізо",x:820,y:410,color:"#c5cbd2",symbol:"◆"},
  {id:7,name:"Камінь",x:350,y:520,color:"#c0b9ad",symbol:"◆"},
  {id:8,name:"Вугілля",x:580,y:485,color:"#424a55",symbol:"◆"},
  {id:9,name:"Ліс",x:850,y:465,color:"#61b86b",symbol:"♣"},
  {id:10,name:"Золото",x:300,y:570,color:"#ffd34f",symbol:"◆"},
  {id:11,name:"Мідь",x:550,y:125,color:"#d88b55",symbol:"◆"},
  {id:12,name:"Камінь",x:740,y:520,color:"#c0b9ad",symbol:"◆"},
  {id:13,name:"Залізо",x:180,y:430,color:"#c5cbd2",symbol:"◆"},
  {id:14,name:"Ліс",x:650,y:580,color:"#61b86b",symbol:"♣"}
 ];

 // ======================================
 // МАЛЮВАННЯ РОДОВИЩ
 // ======================================

 worldResources.forEach(resource=>{

  const group=makeElement("g",{
   transform:`translate(${resource.x} ${resource.y})`,
   class:"map-resource"
  });

  const circle=makeElement("circle",{
   cx:0,
   cy:0,
   r:14,
   fill:"#152331",
   stroke:resource.color,
   "stroke-width":3
  });

  const symbol=makeElement("text",{
   x:0,
   y:5,
   "text-anchor":"middle",
   fill:resource.color,
   "font-size":15,
   "font-weight":"bold"
  });

  symbol.textContent=resource.symbol;

  const title=makeElement("title");
  title.textContent=resource.name;

  group.append(circle,symbol,title);
  resources.appendChild(group);
 });

 window.worldResources=worldResources;

 // ======================================
 // СТИЛІ КАРТИ
 // ======================================

 const style=document.createElement("style");

 style.textContent=`
  .country-territory{
   pointer-events:none;
   transition:fill-opacity .3s;
  }

  .country-label{
   pointer-events:none;
   user-select:none;
  }

  .map-resource{
   cursor:help;
  }

  .map-resource circle{
   filter:drop-shadow(0 2px 4px #0009);
  }

  .map-resource:hover circle{
   stroke-width:4;
  }

  .player-country-border{
   pointer-events:none;
  }
 `;

 document.head.appendChild(style);

 console.log("Частина 2 завантажена успішно");

})();
 
// ======================================
// ДАЛІ ВСТАВИТИ ЧАСТИНУ 3
// НЕ ЗАКРИВАТИ SCRIPT!
// ======================================

// ======================================
// ЧАСТИНА 3 — СТВОРЕННЯ ДЕРЖАВИ ГРАВЦЯ
// ======================================

(() => {
  const map = document.getElementById("worldMap");
  const territoryLayer = document.getElementById("territories");
  const settlementLayer = document.getElementById("settlements");
  const labelLayer = document.getElementById("mapLabels");

  const nameInput = document.getElementById("countryName");
  const capitalInput = document.getElementById("capitalName");
  const modal = document.getElementById("setupModal");
  const foundButton = document.getElementById("foundBtn");

  if (
    !map ||
    !territoryLayer ||
    !settlementLayer ||
    !labelLayer ||
    !foundButton
  ) {
    console.error("Помилка: не знайдено елементи для створення держави");
    return;
  }

  const NS = "http://www.w3.org/2000/svg";

  function createSvgElement(tag, attributes, parent) {
    const element = document.createElementNS(NS, tag);

    Object.entries(attributes).forEach(([key, value]) => {
      element.setAttribute(key, String(value));
    });

    if (parent) parent.appendChild(element);
    return element;
  }

  function showFoundingError(message) {
    if (typeof window.showMessage === "function") {
      window.showMessage(message);
    } else {
      alert(message);
    }
  }

  function createPlayerTerritory(x, y, color) {
    const points = [
      [x - 75, y - 38],
      [x - 35, y - 65],
      [x + 35, y - 60],
      [x + 75, y - 25],
      [x + 65, y + 35],
      [x + 20, y + 65],
      [x - 45, y + 55],
      [x - 80, y + 10]
    ];

    const polygonPoints = points
      .map(point => point.join(","))
      .join(" ");

    return createSvgElement("polygon", {
      points: polygonPoints,
      fill: color,
      "fill-opacity": 0.42,
      stroke: color,
      "stroke-width": 3,
      "stroke-linejoin": "round",
      class: "player-territory"
    }, territoryLayer);
  }

  function createCapital(x, y, name) {
    const group = createSvgElement("g", {
      class: "player-capital"
    }, settlementLayer);

    createSvgElement("circle", {
      cx: x,
      cy: y,
      r: 12,
      fill: "#facc15",
      stroke: "#fff",
      "stroke-width": 3
    }, group);

    createSvgElement("circle", {
      cx: x,
      cy: y,
      r: 4,
      fill: "#713f12"
    }, group);

    const label = createSvgElement("text", {
      x: x + 16,
      y: y - 14,
      fill: "#ffffff",
      "font-size": 15,
      "font-weight": "bold",
      stroke: "#111827",
      "stroke-width": 3,
      "paint-order": "stroke",
      class: "capital-label"
    }, group);

    label.textContent = name;

    return group;
  }

  function updatePlayerStats(country) {
    const values = {
      countryDisplay: country.name,
      yearDisplay: "2016",
      populationDisplay: "25 000",
      treasuryDisplay: "15 000",
      foodDisplay: "8 000",
      woodDisplay: "5 000",
      stoneDisplay: "3 000",
      ironDisplay: "1 000"
    };

    Object.entries(values).forEach(([id, value]) => {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    });
  }

  function foundCountry() {
    if (window.gameStarted) {
      showFoundingError("Держава вже створена!");
      return;
    }

    const name = nameInput
      ? nameInput.value.trim()
      : "";

    const capital = capitalInput
      ? capitalInput.value.trim()
      : "";

    if (name.length < 2) {
      showFoundingError("Введи назву держави (мінімум 2 символи).");
      return;
    }

    if (capital.length < 2) {
      showFoundingError("Введи назву столиці (мінімум 2 символи).");
      return;
    }

    const location = window.selectedLocation;

    if (
      !location ||
      !Number.isFinite(Number(location.x)) ||
      !Number.isFinite(Number(location.y))
    ) {
      showFoundingError("Спочатку обери місце на карті!");
      return;
    }

    const x = Number(location.x);
    const y = Number(location.y);

    if (x < 0 || y < 0 || x > 1000 || y > 700) {
      showFoundingError("Обране місце поза межами карти.");
      return;
    }

    const color = "#38bdf8";

    const country = {
      id: "player_" + Date.now(),
      name,
      capital,
      color,
      year: 2016,
      population: 25000,
      treasury: 15000,
      food: 8000,
      wood: 5000,
      stone: 3000,
      iron: 1000,
      x,
      y,
      isPlayer: true
    };

    try {
      createPlayerTerritory(x, y, color);
      createCapital(x, y, capital);

      const countryLabel = createSvgElement("text", {
        x,
        y: y + 95,
        fill: "#ffffff",
        "font-size": 17,
        "font-weight": "bold",
        "text-anchor": "middle",
        stroke: "#111827",
        "stroke-width": 4,
        "paint-order": "stroke",
        class: "player-country-label"
      }, labelLayer);

      countryLabel.textContent = name;

      window.playerCountry = country;
      window.gameStarted = true;

      if (Array.isArray(window.worldStates)) {
        window.worldStates.push(country);
      }

      updatePlayerStats(country);

      if (modal) {
        modal.style.display = "none";
      }

      const marker = document.getElementById("mapMarkers");
      if (marker) marker.innerHTML = "";

      window.selectedLocation = null;

      window.dispatchEvent(new CustomEvent("countryFounded", {
        detail: country
      }));

      showFoundingError("Державу «" + name + "» успішно створено!");

      console.log("Державу створено:", country);

    } catch (error) {
      console.error("Помилка створення держави:", error);
      showFoundingError("Не вдалося створити державу. Перевір консоль.");
    }
  }

  foundButton.addEventListener("click", foundCountry);

  console.log("Частина 3 завантажена успішно");
})();

// ======================================
// ДАЛІ ВСТАВИТИ ЧАСТИНУ 4
