function addHistory(message) {
    gameData.history.unshift(message);
    gameData.history = gameData.history.slice(0, 100);

    const log = document.getElementById("log");

    if (log) {
        log.innerHTML = gameData.history
            .map(item => `<div>• ${escapeHTML(item)}</div>`)
            .join("");
    }
}

function escapeHTML(value) {
    return String(value).replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[char]);
}

function startGame() {
    if (gameData.started) return;

    const countryName = document.getElementById("countryName").value.trim();
    const cityName = document.getElementById("cityName").value.trim();

    if (!countryName || !cityName) {
        alert("Введи назву країни та першого міста!");
        return;
    }

    gameData.country = countryName;
    gameData.started = true;

    document.getElementById("startScreen").style.display = "none";
    document.getElementById("game").style.display = "block";

    document.getElementById("countryTitle").textContent =
        "🇺🇦 " + gameData.country;

    document.getElementById("gameStatus").textContent =
        "Натисни на карту України, щоб обрати місце для першого міста.";

    initializeMap();

    addHistory("2016 рік. Створено країну " + gameData.country);
    updateInterface();

    window.setInterval(gameTick, 3000);
}

function initializeMap() {
    if (map) return;

    map = L.map("map", {
        center: [48.8, 31.2],
        zoom: 6,
        minZoom: 5,
        maxZoom: 13
    });

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors",
        maxZoom: 19
    }).addTo(map);

    map.on("click", function(event) {
        createSettlement(event.latlng.lat, event.latlng.lng);
    });

    ukrainianPlaces.forEach(place => {
        L.circleMarker([place.lat, place.lng], {
            radius: 4,
            color: "#263c46",
            fillColor: "#ffffff",
            fillOpacity: 0.9
        })
        .addTo(map)
        .bindTooltip(place.name);
    });

    addRivers();
}

function addRivers() {
    const rivers = [
        {
            name: "Дніпро",
            points: [
                [51.5, 30.5],
                [50.8, 30.6],
                [50.1, 30.5],
                [49.4, 32.0],
                [48.5, 34.0],
                [47.8, 35.1],
                [46.6, 32.6]
            ]
        },
        {
            name: "Дністер",
            points: [
                [49.0, 26.0],
                [48.5, 26.5],
                [48.0, 27.5],
                [47.5, 28.0],
                [46.5, 30.0]
            ]
        },
        {
            name: "Південний Буг",
            points: [
                [49.5, 27.0],
                [49.0, 28.0],
                [48.5, 29.0],
                [47.5, 30.0],
                [46.5, 31.5]
            ]
        }
    ];

    rivers.forEach(river => {
        const line = L.polyline(river.points, {
            color: "#2498db",
            weight: 3,
            opacity: 0.8
        }).addTo(map);

        line.bindTooltip(river.name);
        mapLayers.push(line);
    });
}

function createSettlement(lat, lng) {
    if (!gameData.started) return;

    const insideUkraine =
        lat >= 44.2 &&
        lat <= 52.5 &&
        lng >= 22.0 &&
        lng <= 40.3;

    if (!insideUkraine) {
        alert("Обери місце в межах ігрової карти України.");
        return;
    }

    if (gameData.cities.length === 0) {
        createCity(
            document.getElementById("cityName").value.trim(),
            lat,
            lng
        );
        return;
    }

    const answer = confirm(
        "Створити нове поселення в цьому місці?\n" +
        "Так — місто\nНі — село"
    );

    if (answer) {
        const name = prompt("Назва нового міста:");

        if (name && name.trim()) {
            createCity(name.trim(), lat, lng);
        }
    } else {
        const name = prompt("Назва нового села:");

        if (name && name.trim()) {
            createVillage(name.trim(), lat, lng);
        }
    }
}

function createCity(name, lat, lng) {
    if (!name || !name.trim()) return;

    if (gameData.money < 10000) {
        alert("Недостатньо гривень для заснування міста!");
        return;
    }

    gameData.money -= 10000;

    const city = {
        id: Date.now() + Math.random(),
        name: name.trim(),
        lat: lat,
        lng: lng,
        population: 1000,
        happiness: 75,
        level: 1,
        type: "місто",
        buildings: [],
        factories: 0,
        bridges: 0,
        farms: 0,
        roads: 0,
        damaged: false
    };

    gameData.cities.push(city);

    const marker = L.marker([lat, lng])
        .addTo(map)
        .bindPopup(
            `<b>${escapeHTML(city.name)}</b><br>` +
            `Населення: ${city.population}`
        );

    mapMarkers.push(marker);

    document.getElementById("mainCity").textContent =
        "Головне місто: " + city.name;

    addHistory("Засновано місто " + city.name);

    updateInterface();
    selectCity(city.id);
}

function createVillage(name, lat, lng) {
    if (gameData.money < 2000) {
        alert("Недостатньо гривень для заснування села!");
        return;
    }

    gameData.money -= 2000;

    const village = {
        id: Date.now() + Math.random(),
        name: name.trim(),
        lat: lat,
        lng: lng,
        population: 100,
        level: 1,
        happiness: 80,
        type: "село"
    };

    gameData.villages.push(village);

    const marker = L.circleMarker([lat, lng], {
        radius: 6,
        color: "#267b39",
        fillColor: "#72d77d",
        fillOpacity: 1
    })
    .addTo(map)
    .bindPopup(
        `<b>${escapeHTML(village.name)}</b><br>` +
        `Село<br>Населення: ${village.population}`
    );

    mapMarkers.push(marker);

    addHistory("Засновано село " + village.name);

    updateInterface();
}

function selectCity(id) {
    gameData.selectedCity =
        gameData.cities.find(city => city.id === id) || null;

    updateInterface();
}

function updateInterface() {
    document.getElementById("year").textContent = gameData.year;

    document.getElementById("money").textContent =
        Math.floor(gameData.money).toLocaleString("uk-UA") + " ₴";

    const totalPopulation =
        gameData.cities.reduce((sum, city) => sum + city.population, 0) +
        gameData.villages.reduce((sum, village) => sum + village.population, 0);

    document.getElementById("population").textContent =
        Math.floor(totalPopulation).toLocaleString("uk-UA");

    document.getElementById("cities").textContent =
        gameData.cities.length;

    document.getElementById("villages").textContent =
        gameData.villages.length;

    updateCityList();
}

function updateCityList() {
    const container = document.getElementById("cityList");

    if (!container) return;

    let html = "";

    gameData.cities.forEach(city => {
        html += `
            <div class="panel">
                <b>🏙 ${escapeHTML(city.name)}</b>
                <p>Населення: ${Math.floor(city.population)}</p>
                <p>Рівень: ${city.level}</p>
                <p>Задоволеність: ${city.happiness}%</p>
                <button onclick="selectCity(${city.id})">
                    Обрати місто
                </button>
            </div>
        `;
    });

    gameData.villages.forEach(village => {
        html += `
            <div class="panel">
                <b>🏡 ${escapeHTML(village.name)}</b>
                <p>Населення: ${Math.floor(village.population)}</p>
                <p>Рівень: ${village.level}</p>
            </div>
        `;
    });

    container.innerHTML = html || "Поселень поки немає.";
}

