// ======================================
// ЧАСТИНА 6 — ЗБЕРЕЖЕННЯ ТА ЗАВЕРШЕННЯ
// ======================================

(() => {
  const SAVE_KEY = "world_states_game_2016_save_v1";

  const savePanel = document.createElement("section");
  savePanel.id = "savePanel";

  savePanel.style.cssText = `
    background:#1b2b3b;
    border:1px solid #38516a;
    border-radius:12px;
    padding:14px;
    margin:12px;
    color:#f1f5f9;
  `;

  savePanel.innerHTML = `
    <h3 style="margin:0 0 12px">💾 Збереження гри</h3>

    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button id="saveGameBtn">💾 Зберегти</button>
      <button id="loadGameBtn">📂 Завантажити</button>
      <button id="resetGameBtn">🔄 Нова гра</button>
    </div>

    <div id="saveStatus" style="
      margin-top:12px;
      padding:9px;
      background:#101923;
      border-radius:8px;
    ">Гра ще не збережена.</div>
  `;

  const saveStyle = document.createElement("style");
  saveStyle.textContent = `
    #savePanel button {
      background:#2563a6;
      color:white;
      border:0;
      border-radius:7px;
      padding:9px 11px;
      cursor:pointer;
      font-weight:bold;
    }
    #savePanel button:active {
      transform:scale(.97);
    }
  `;

  document.head.appendChild(saveStyle);

  const target =
    document.querySelector("aside") ||
    document.querySelector(".sidebar") ||
    document.querySelector("main");

  if (target) {
    target.appendChild(savePanel);
  } else {
    document.body.appendChild(savePanel);
  }

  const saveStatus = document.getElementById("saveStatus");

  function getBuildings() {
    return window.gameBuildings || {
      farm: 0,
      house: 0
    };
  }

  function saveGame() {
    try {
      const data = {
        gameStarted: window.gameStarted,
        playerCountry: window.playerCountry,
        worldStates: window.worldStates,
        worldResources: window.worldResources,
        selectedLocation: window.selectedLocation
      };

      localStorage.setItem(SAVE_KEY, JSON.stringify(data));

      saveStatus.textContent =
        "✅ Гру збережено: " +
        new Date().toLocaleTimeString("uk-UA");

    } catch (error) {
      console.error("Помилка збереження:", error);
      saveStatus.textContent =
        "❌ Не вдалося зберегти гру.";
    }
  }

  function loadGame() {
    try {
      const raw = localStorage.getItem(SAVE_KEY);

      if (!raw) {
        saveStatus.textContent = "Збереження не знайдено.";
        return;
      }

      const data = JSON.parse(raw);

      if (!data || typeof data !== "object") {
        throw new Error("Некоректне збереження");
      }

      window.gameStarted = Boolean(data.gameStarted);
      window.playerCountry = data.playerCountry || null;

      if (Array.isArray(data.worldStates)) {
        window.worldStates = data.worldStates;
      }

      if (Array.isArray(data.worldResources)) {
        window.worldResources = data.worldResources;
      }

      window.selectedLocation = data.selectedLocation || null;

      if (window.playerCountry) {
        const country = window.playerCountry;

        const values = {
          countryDisplay: country.name,
          yearDisplay: country.year,
          populationDisplay: Number(country.population || 0).toLocaleString("uk-UA"),
          treasuryDisplay: Number(country.treasury || 0).toLocaleString("uk-UA"),
          foodDisplay: Number(country.food || 0).toLocaleString("uk-UA"),
          woodDisplay: Number(country.wood || 0).toLocaleString("uk-UA"),
          stoneDisplay: Number(country.stone || 0).toLocaleString("uk-UA"),
          ironDisplay: Number(country.iron || 0).toLocaleString("uk-UA")
        };

        Object.entries(values).forEach(([id, value]) => {
          const element = document.getElementById(id);
          if (element) element.textContent = value;
        });

        const modal = document.getElementById("setupModal");
        if (modal) {
          modal.style.display = "none";
        }

        window.dispatchEvent(new CustomEvent("countryFounded", {
          detail: country
        }));
      }

      saveStatus.textContent = "✅ Збереження завантажено.";

    } catch (error) {
      console.error("Помилка завантаження:", error);
      saveStatus.textContent =
        "❌ Збереження пошкоджене або несумісне.";
    }
  }

  function resetGame() {
    const confirmed = confirm(
      "Почати нову гру? Поточний прогрес буде видалено."
    );

    if (!confirmed) return;

    localStorage.removeItem(SAVE_KEY);
    location.reload();
  }

  document.getElementById("saveGameBtn").addEventListener(
    "click",
    saveGame
  );

  document.getElementById("loadGameBtn").addEventListener(
    "click",
    loadGame
  );

  document.getElementById("resetGameBtn").addEventListener(
    "click",
    resetGame
  );

  // Автоматичне збереження раз на 20 секунд
  setInterval(() => {
    if (window.gameStarted && window.playerCountry) {
      saveGame();
    }
  }, 20000);

  // Спроба відновити збереження при запуску
  if (localStorage.getItem(SAVE_KEY)) {
    loadGame();
  }

  console.log("Частина 6 завантажена успішно");
})();

// ======================================
// КІНЕЦЬ ГРИ
// ======================================
</script>
