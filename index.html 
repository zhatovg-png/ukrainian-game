<style>
*{box-sizing:border-box}
body{margin:0;background:#101923;color:#f1f5f9;font-family:Arial}
header{padding:12px;background:#172b39;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
header h2{margin:0;font-size:19px}
button{background:#2878b9;color:white;border:0;border-radius:7px;padding:10px;font-weight:bold;cursor:pointer}
button:disabled{opacity:.4}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;height:calc(100vh - 58px)}
.mapArea{position:relative;min-width:0;overflow:hidden;background:#79aeb0}
#worldMap{width:100%;height:100%;display:block;touch-action:none;user-select:none}
.sidebar{background:#172633;padding:12px;overflow:auto}
.panel{background:#213442;padding:12px;border-radius:9px;margin-bottom:10px}
.panel h3{margin:0 0 10px}
.stat{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid #405362;font-size:14px}
.tabs{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:10px}
.tabs button{font-size:12px;background:#344c5d}
.tabs button.active{background:#2878b9}
.tabContent{display:none}
.tabContent.active{display:block}
.item{background:#2c4353;padding:10px;margin:6px 0;border-radius:7px}
input{width:100%;padding:11px;margin:6px 0;background:#12212c;color:white;border:1px solid #536b7b;border-radius:6px}
label{font-size:13px}
.small{font-size:12px;color:#b7c7d3;line-height:1.5}
#setup{position:fixed;inset:0;background:#000d;z-index:10;display:flex;align-items:center;justify-content:center;padding:15px;overflow:auto}
.setupBox{background:#203544;padding:20px;border-radius:12px;width:100%;max-width:430px;max-height:95vh;overflow:auto}
.setupBox h2{margin-top:0}
.mapMessage{position:absolute;top:10px;left:50%;transform:translateX(-50%);background:#172633ed;padding:10px;border-radius:8px;text-align:center;font-size:13px;z-index:2;width:max-content;max-width:90%;pointer-events:none}
.legend{position:absolute;bottom:10px;left:10px;background:#172633ed;padding:9px;border-radius:8px;font-size:12px;line-height:1.8;pointer-events:none}
.miniFrame{background:#132a35;padding:6px;border-radius:9px;margin:10px 0}
#miniMap{width:100%;height:125px;display:block;border-radius:6px;touch-action:none}
.cityPulse{animation:pulse 2.5s infinite}
.smoke{animation:smoke 3s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.55}}
@keyframes smoke{0%{opacity:.1;transform:translateY(3px)}50%{opacity:.6}100%{opacity:.1;transform:translateY(-5px)}}
@media(max-width:800px){
.layout{display:flex;flex-direction:column;height:auto}
.mapArea{height:55vh;min-height:350px}
.sidebar{overflow:visible}
}
</style>
