function startWar() {
    if (gameData.war.active) {
        alert("Війна вже триває!");
        return;
    }

    if (gameData.cities.length === 0) {
        alert("Спочатку заснуй місто!");
        return;
    }

    const confirmed = confirm(
        "Розпочати військовий сценарій?\n" +
        "Можливі економічні втрати та пошкодження інфраструктури."
    );

    if (!confirmed) return;

    gameData.war.active = true;

    addHistory("Розпочався військовий сценарій.");

    updateWarPanel();
    updateInterface();
}

function endWar() {
    if (!gameData.war.active) return;

    gameData.war.active = false;

    addHistory(
        "Військовий сценарій завершено. Починається відновлення."
    );

    updateWarPanel();
    updateInterface();
}

function warEvent() {
    if (!gameData.war.active) return;

    if (gameData.cities.length === 0) return;

    const city = gameData.cities[
        Math.floor(Math.random() * gameData.cities.length)
    ];

    const event = Math.floor(Math.random() * 4);

    if (event === 0) {
        city.damaged = true;
        city.happiness = Math.max(
            0,
            city.happiness - 8
        );

        addHistory(
            "Місто " + city.name +
            " зазнало пошкоджень. Потрібне відновлення."
        );
    }

    if (event === 1 && city.bridges > 0) {
        city.bridges--;

        gameData.war.destroyedBridges++;

        createPontoon(city);

        addHistory(
            "У місті " + city.name +
            " пошкоджено міст. Створено тимчасову понтонну переправу."
        );
    }

    if (event === 2) {
        city.happiness = Math.max(
            0,
            city.happiness - 5
        );

        addHistory(
            "У місті " + city.name +
            " знизилася задоволеність населення."
        );
    }

    if (event === 3) {
        addHistory(
            "У країні відбулася військова подія. " +
            "Міста потребують підтримки."
        );
    }

    updateWarPanel();
    updateInterface();
}

